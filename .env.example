# Supabase project: grackles (eu-west-2)
# Both values are safe to expose to the browser — the publishable key only
# grants what RLS allows. Never put the service-role key in this file.
PUBLIC_SUPABASE_URL=https://ophmsvqtzffrjmyjyzza.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_aMpGmFihEDec3LxcftSP0w_Fgw68doq

# Where magic links come back to. Must match a URL allowed in
# Supabase → Authentication → URL Configuration.
SITE_URL=http://localhost:4321

# Sends workspace invitations. Server-only — no PUBLIC_ prefix, because this
# one is a real secret. The key is sending-only and restricted to
# grackles.co.uk. Leave it unset and invitations are still created; the
# settings page falls back to showing a link to pass on by hand.
RESEND_API_KEY=

# Optional. Any address at the verified domain works.
# INVITE_FROM_EMAIL=Grackles <invites@grackles.co.uk>

# Note: this key is for invitations only. Supabase sends its own magic-link
# emails and does not read it — point Supabase → Authentication → Emails →
# SMTP at smtp.resend.com to move those off the shared default sender.
