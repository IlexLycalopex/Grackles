---
import '../styles/cigar-lounge.css';
import type { ResolvedWorkspace } from '../lib/workspace';

interface Props {
  title: string;
  description?: string;
  workspace: ResolvedWorkspace;
}

const { title, description = '', workspace } = Astro.props;
const base = `/cigars/${workspace.slug}`;
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, Astro.site ?? Astro.url.origin);
const { user } = Astro.locals;

// The reference desk is offered only to people who can use it: the endpoint
// behind it is `canWrite`, so linking it for a viewer would be advertising a
// page that answers 403.
const links = [
  { href: base, label: 'Log' },
  { href: `${base}/humidor`, label: 'Humidor' },
  // Readable by anyone who can read the lounge, so it is not behind the same
  // gate as the desk below: what somebody is after is part of the record.
  { href: `${base}/wishlist`, label: 'Wishlist' },
  { href: `${base}/stats`, label: 'Stats' },
  ...(workspace.canWrite ? [{ href: `${base}/lookup`, label: 'Look up' }] : []),
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/cedarhouse.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* The three faces cigar-lounge.css names in --display/--body/--mono.
        Without these the whole app silently falls back to system sans, which
        costs the design every bit of its typographic character. The Cormorant
        italic is loaded because the log headline sets its closing phrase in
        it. */}
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=Karla:wght@300;400;500&family=Space+Mono&display=swap"
      rel="stylesheet"
    />
    {workspace.visibility !== 'public' && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <nav class="site-nav">
      <div class="container site-nav__inner">
        {/* The wordmark, not the lounge's name. Whose lounge it is already
            stands in the page title and the role chip; the nav carries the
            brand, the same on every workspace. */}
        <a href={base} class="site-nav__logo">Cedarhouse</a>
        <div class="site-nav__links">
          {
            links.map(l => (
              <a href={l.href} class={`site-nav__pill${pathname === l.href ? ' active' : ''}`}>
                {l.label}
              </a>
            ))
          }
          {workspace.role && <span class="site-nav__pill site-nav__role">{workspace.role}</span>}
          <a class="site-nav__pill" href={user ? '/dashboard' : `/login?next=${pathname}`}>
            {user ? 'Projects' : 'Sign in'}
          </a>
        </div>
      </div>
    </nav>

    <slot />
  </body>
</html>
