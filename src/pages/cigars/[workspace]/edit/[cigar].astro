---
import ClLayout from '../../../../layouts/ClLayout.astro';
import CigarFields from '../../../../components/cl/CigarFields.astro';
import { requireWrite } from '../../../../lib/workspace';
import { loadCigar } from '../../../../lib/cigar-lounge';
import { homeFor } from '../../../../lib/cigar-helpers';
import ConfirmDelete from '../../../../components/ConfirmDelete.astro';
import { readCigar } from '../../../../lib/records/cigar';
import { NOTHING_DELETED, describeDeleteError, describeWriteError } from '../../../../lib/records/save';

export const prerender = false;

const { supabase, user } = Astro.locals;
const { workspace: wsSlug, cigar: cigarSlug } = Astro.params;

const gate = await requireWrite(
  supabase,
  'cigar-lounge',
  wsSlug!,
  user?.id ?? null,
  Astro.url.pathname + Astro.url.search
);
if (!gate.ok) return gate.response;
const workspace = gate.workspace;

let cigar = await loadCigar(supabase, workspace.id, cigarSlug!);
if (!cigar) return new Response('Not found', { status: 404 });

const base = `/cigars/${workspace.slug}`;
const confirmingDelete = Astro.url.searchParams.get('delete') === '1';

let error: string | null = null;
let submitted: FormData | null = null;

if (Astro.request.method === 'POST') {
  submitted = await Astro.request.formData();

  if (submitted.get('intent') === 'delete') {
    const { data: removed, error: deleteError } = await supabase
      .from('cl_cigars')
      .delete()
      .eq('id', cigar.rowId)
      .select('id');

    if (deleteError) {
      error = describeDeleteError(deleteError, 'cl_cigars delete');
      submitted = null;
    } else if (!removed || removed.length === 0) {
      // RLS does not refuse a delete, it narrows it to nothing. Saying
      // "deleted" here would be a lie the page could not detect.
      error = NOTHING_DELETED;
      submitted = null;
    } else {
      return Astro.redirect(homeFor(base, cigar.data.status));
    }
  } else {
    const parsed = readCigar(submitted);

    if (!parsed.ok) {
      error = parsed.error;
    } else {
      // The slug is not in the payload: it is the URL of this page and of the
      // entry, and it was minted from the date and name when the record was
      // created. Renaming a cigar should not move a page somebody has open.
      const { error: writeError } = await supabase
        .from('cl_cigars')
        .update(parsed.values)
        .eq('id', cigar.rowId);

      if (writeError) {
        error = describeWriteError(writeError, 'cl_cigars update');
      } else {
        return Astro.redirect(homeFor(base, parsed.values.status));
      }
    }
  }

  cigar = (await loadCigar(supabase, workspace.id, cigarSlug!)) ?? cigar;
}

const d = cigar.data;
---

<ClLayout title={`Edit ${d.name} · ${workspace.name}`} workspace={workspace}>
  <div class="container">
    <div class="page-header">
      <p class="eyebrow">{d.brand}</p>
      <h1>{d.name}</h1>
    </div>

    {error && <p class="form-error" role="alert">{error}</p>}

    {
      confirmingDelete ? (
        <ConfirmDelete
          prefix="cigar-form"
          title={[d.brand, d.name].filter(Boolean).join(' ')}
          detail={
            d.status === 'wishlist'
              ? 'This comes off the wishlist. Nothing else changes.'
              : d.status === 'humidor'
                ? `${d.quantity} in the humidor — all of them go.`
                : 'This entry leaves the log, and the stats with it.'
          }
          cancelHref={`${base}/edit/${cigar.id}`}
        />
      ) : (
        <form method="POST" class="cigar-form">
          <CigarFields cigar={cigar} submitted={submitted} />

          <div class="cigar-form__actions">
            <button class="cigar-form__submit" type="submit">Save</button>
            <a class="cigar-form__cancel" href={homeFor(base, d.status)}>Cancel</a>
            <a class="cigar-form__delete" href={`${base}/edit/${cigar.id}?delete=1`}>Delete</a>
          </div>
        </form>
      )
    }
  </div>
</ClLayout>
