---
import ClLayout from '../../../layouts/ClLayout.astro';
import CigarCard from '../../../components/cl/CigarCard.astro';
import CigarFilter from '../../../components/cl/CigarFilter.astro';
import { resolveWorkspace } from '../../../lib/workspace';
import { humidorFrom, loadCigars } from '../../../lib/cigar-lounge';
import { totalCigars } from '../../../lib/cigar-helpers';

export const prerender = false;

const { supabase, user } = Astro.locals;
const wsSlug = Astro.params.workspace!;

const workspace = await resolveWorkspace(supabase, 'cigar-lounge', wsSlug, user?.id ?? null);
if (!workspace) return new Response('Not found', { status: 404 });

const base = `/cigars/${workspace.slug}`;
const humidor = humidorFrom(await loadCigars(supabase, workspace.id));
---

<ClLayout title={`Humidor · ${workspace.name}`} workspace={workspace}>
  <div class="container">
    <div class="page-header">
      <p class="eyebrow">Resting</p>
      <h1>Humidor</h1>
      <p class="subtitle">
        {totalCigars(humidor)} cigars across {humidor.length} entr{humidor.length === 1 ? 'y' : 'ies'},
        longest-resting first.
      </p>
    </div>

    {
      workspace.canWrite && (
        <div class="record-actions">
          <a class="record-actions__btn record-actions__btn--primary" href={`${base}/new?status=humidor`}>
            + Add to humidor
          </a>
          <a class="record-actions__btn" href={`${base}/new?status=smoked`}>
            Log a smoke
          </a>
        </div>
      )
    }

    {
      humidor.length === 0 ? (
        <p class="empty-state">The humidor is empty.</p>
      ) : (
        <>
        <CigarFilter grid="humidor-grid" noun="resting" />
        <div class="cigar-grid" id="humidor-grid">
          {humidor.map(cigar => (
            <CigarCard
              cigar={cigar}
              base={base}
              editHref={workspace.canWrite ? `${base}/edit/${cigar.id}` : undefined}
              smokeHref={workspace.canWrite ? `${base}/smoke/${cigar.id}` : undefined}
            />
          ))}
        </div>
        </>
      )
    }
  </div>
</ClLayout>
