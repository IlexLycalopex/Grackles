---
import ClLayout from '../../../../layouts/ClLayout.astro';
import StarRating from '../../../../components/cl/StarRating.astro';
import StrengthChip from '../../../../components/cl/StrengthChip.astro';
import ReferenceBlock from '../../../../components/cl/ReferenceBlock.astro';
import { resolveWorkspace } from '../../../../lib/workspace';
import { humidorFrom, loadCigar, loadCigars, loadReference, smokedFrom } from '../../../../lib/cigar-lounge';
import { formatDate, formatDuration, formatSize, photoUrl, restingDays } from '../../../../lib/cigar-helpers';

export const prerender = false;

const { supabase, user } = Astro.locals;
const { workspace: wsSlug, cigar: cigarSlug } = Astro.params;

const workspace = await resolveWorkspace(supabase, 'cigar-lounge', wsSlug!, user?.id ?? null);
if (!workspace) return new Response('Not found', { status: 404 });

const cigar = await loadCigar(supabase, workspace.id, cigarSlug!);
if (!cigar) return new Response('Not found', { status: 404 });

const base = `/cigars/${workspace.slug}`;
const d = cigar.data;
const inHumidor = d.status === 'humidor';
const spec = formatSize(d.length, d.ringGauge);
const resting = inHumidor ? restingDays(cigar) : null;

// Previous/next within the list this entry belongs to, so the arrows stay in
// the same ordering the log or humidor page used.
// What a lookup said about this cigar, when it was filled from one. Null for
// an entry typed by hand, and null for a signed-out visitor to a public lounge
// — the cache is readable to members, and what a model said was never part of
// the published record anyway.
const reference = cigar.referenceId ? await loadReference(supabase, cigar.referenceId) : null;

const all = await loadCigars(supabase, workspace.id);
const siblings = inHumidor ? humidorFrom(all) : smokedFrom(all);
const index = siblings.findIndex(c => c.id === cigar.id);
const prev = index > 0 ? siblings[index - 1] : null;
const next = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : null;

const facts = [
  d.country && { label: 'Country', value: d.country },
  d.wrapper && { label: 'Wrapper', value: d.wrapper },
  d.vitola && { label: 'Vitola', value: d.vitola },
  d.pricePaid && { label: 'Price', value: d.pricePaid },
  d.pairing && { label: 'Pairing', value: d.pairing },
  d.boughtAt && { label: 'Bought at', value: d.boughtAt },
  d.smokedAt && { label: 'Smoked at', value: d.smokedAt },
  d.dateSmoked && { label: 'Smoked', value: formatDate(d.dateSmoked) },
  d.dateAcquired && { label: 'Acquired', value: formatDate(d.dateAcquired) },
  resting !== null && { label: 'Resting', value: formatDuration(resting) },
  inHumidor && d.quantity > 1 && { label: 'Quantity', value: `×${d.quantity}` },
].filter(Boolean) as { label: string; value: string }[];
---

<ClLayout
  title={`${d.name} · ${workspace.name}`}
  description={`${d.brand} ${d.name}`}
  workspace={workspace}
>
  <div class="container">
    <a class="back-link" href={inHumidor ? `${base}/humidor` : base}>← Back</a>

    <article class="entry">
      <header class="entry__header">
        <p class="entry__brand">{d.brand}</p>
        <h1 class="entry__name foil">{d.name}</h1>
        {spec && <p class="entry__spec">{spec}</p>}

        {
          d.rating !== undefined && (
            <div class="entry__score">
              <span class="score score--lg">
                {/* Sized down from the 1rem default: five diamonds at full size
                    are wider than the 88px medallion they sit in. */}
                <StarRating rating={d.rating} size="0.6rem" />
                <span class="score__value">{d.rating.toFixed(1)}</span>
              </span>
            </div>
          )
        }

        <div class="entry__meta">
          {inHumidor && <span class="entry__badge entry__badge--quiet">In humidor</span>}
          {d.strength && <StrengthChip strength={d.strength} />}
          {
            workspace.canWrite && (
              <a class="entry__badge" href={`${base}/edit/${cigar.id}`}>
                Edit
              </a>
            )
          }
        </div>
      </header>

      {
        d.photo && (
          <div class="entry__photo">
            <img src={photoUrl(d.photo)} alt={d.name} width="900" height="600" />
          </div>
        )
      }

      {
        facts.length > 0 && (
          <dl class="entry__facts">
            {facts.map(f => (
              <div class="entry__fact">
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        )
      }

      {d.note && <p class="entry__note">{d.note}</p>}

      {
        cigar.body && (
          <section class="entry__notes">
            <p class="eyebrow entry__notes-label">Tasting notes</p>
            <div class="prose">
              {cigar.body.split(/\n{2,}/).map(para => (
                <p>{para}</p>
              ))}
            </div>
          </section>
        )
      }
      {reference && <ReferenceBlock reference={reference} entry={d} />}
    </article>

    {
      (prev || next) && (
        <nav class="entry-nav">
          {prev ? (
            <a class="entry-nav__link" href={`${base}/cigar/${prev.id}`}>
              <span class="entry-nav__dir">Previous</span>
              <span class="entry-nav__name">{prev.data.name}</span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="entry-nav__link entry-nav__link--next" href={`${base}/cigar/${next.id}`}>
              <span class="entry-nav__dir">Next</span>
              <span class="entry-nav__name">{next.data.name}</span>
            </a>
          )}
        </nav>
      )
    }
  </div>
</ClLayout>

<style>
  /* The record card. This page was shipped with its markup complete but no
     styles at all — none of the .entry* names below resolved anywhere in
     cigar-lounge.css, so it rendered as bare HTML. The composition follows
     the Oxblood Foil pattern used by the log and stats screens: a centred
     masthead, Space Mono micro-labels doing the signposting, and gold
     hairlines separating the movements. */

  .back-link {
    display: inline-block;
    margin-top: 2.25rem;
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-dim);
    transition: color var(--transition);
  }

  .back-link:hover { color: var(--foil); }

  /* Capped well short of the 1160px container: this page is a reading page,
     and both the tasting note and the fact grid fall apart at full width. */
  .entry {
    max-width: 62rem;
    margin: 0 auto;
  }

  /* ── Masthead ───────────────────────────────────────────────────── */
  .entry__header {
    text-align: center;
    padding: 2.5rem 0 2.75rem;
  }

  .entry__brand {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--gold-label);
  }

  .entry__name {
    margin-top: 0.85rem;
    font-size: clamp(2.4rem, 6.5vw, 4.25rem);
    line-height: 1.02;
  }

  .entry__spec {
    margin-top: 0.9rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    color: var(--text-muted);
  }

  .entry__score {
    display: flex;
    justify-content: center;
    margin-top: 1.9rem;
  }

  /* The medallion stacks diamonds over numeral; without a gap they collide,
     because .score sets line-height 0.8 to tighten the numeral itself. */
  .entry__score .score { gap: 0.35rem; }

  .entry__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 1.6rem;
  }

  .entry__badge {
    padding: 0.42rem 0.95rem;
    border: 1px solid var(--border-gold);
    border-radius: 22px;
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--foil);
    transition: color var(--transition), background var(--transition);
  }

  a.entry__badge:hover {
    background: var(--bg-hover);
    color: var(--foil-light);
  }

  /* "In humidor" is a state, not an action. It drops the gold edge so the
     only gold-ringed chip on the page is the one you can actually click. */
  .entry__badge--quiet {
    border-color: var(--border);
    color: var(--gold-muted);
  }

  /* ── Photo ──────────────────────────────────────────────────────── */
  .entry__photo {
    margin-bottom: 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--bg-card);
  }

  .entry__photo img {
    display: block;
    width: 100%;
    height: auto;
    /* Still capped — phone photos of a single cigar are often tall, and
       unbounded they push the specification off the first screen. But this is
       the page you opened to look at the thing, so the cap is generous and
       tied to the viewport rather than a fixed height that fills a laptop.
       `contain` because a cap that crops is a cap that hides the band: the
       card has the cropped version, this one shows the whole photo. */
    max-height: min(75vh, 42rem);
    object-fit: contain;
  }

  /* ── Specification ──────────────────────────────────────────────── */
  /* auto-fit rather than a fixed column count: entries carry anywhere from
     two facts to eleven, and a fixed grid strands a lone item on a wide row. */
  .entry__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));
    gap: 1.65rem 1.75rem;
    padding: 2.1rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .entry__fact {
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
    min-width: 0;
  }

  .entry__fact dt {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold-label);
  }

  .entry__fact dd {
    font-family: var(--display);
    font-size: 1.15rem;
    line-height: 1.3;
    color: var(--text);
    /* Shop names and pairings run long and there is no room to scroll here. */
    overflow-wrap: anywhere;
  }

  /* ── Aside and tasting notes ────────────────────────────────────── */
  /* The one-liner — who you smoked it with, which order it came in. Centred
     serif so it reads as a caption rather than the start of the body copy. */
  .entry__note {
    max-width: 46ch;
    margin: 2.4rem auto 0;
    font-family: var(--display);
    font-style: italic;
    font-size: 1.2rem;
    line-height: 1.55;
    text-align: center;
    color: var(--text-muted);
  }

  .entry__notes {
    max-width: 40rem;
    margin: 3rem auto 0;
  }

  .entry__notes-label {
    text-align: center;
    margin-bottom: 1.1rem;
  }

  .prose p {
    font-size: 1.02rem;
    line-height: 1.85;
    color: var(--text-2);
  }

  .prose p + p { margin-top: 1.15rem; }

  /* ── Previous / next ────────────────────────────────────────────── */
  .entry-nav {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    max-width: 62rem;
    margin: 3.75rem auto 0;
    padding-top: 1.85rem;
    border-top: 1px solid var(--border);
  }

  /* The placeholder the template renders when there is no previous entry. */
  .entry-nav > span:empty { display: none; }

  .entry-nav__link {
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
    max-width: 45%;
  }

  .entry-nav__link--next {
    margin-left: auto;
    text-align: right;
  }

  .entry-nav__dir {
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-dim);
    transition: color var(--transition);
  }

  .entry-nav__name {
    font-family: var(--display);
    font-size: 1.15rem;
    line-height: 1.25;
    color: var(--text-muted);
    transition: color var(--transition);
  }

  .entry-nav__link:hover .entry-nav__dir { color: var(--gold-label); }
  .entry-nav__link:hover .entry-nav__name { color: var(--foil); }

  @media (max-width: 640px) {
    .entry__header { padding: 1.75rem 0 2rem; }
    .entry__facts { gap: 1.35rem; padding: 1.75rem 0; }
    .entry-nav { flex-direction: column; }

    .entry-nav__link,
    .entry-nav__link--next {
      max-width: none;
      margin-left: 0;
      text-align: left;
    }
  }
</style>
