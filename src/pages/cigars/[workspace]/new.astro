---
import ClLayout from '../../../layouts/ClLayout.astro';
import CigarFields from '../../../components/cl/CigarFields.astro';
import CigarLookup from '../../../components/cl/CigarLookup.astro';
import { requireWrite } from '../../../lib/workspace';
import { loadCigars, loadReference } from '../../../lib/cigar-lounge';
import { cigarSlug, readCigar } from '../../../lib/records/cigar';
import { describeWriteError } from '../../../lib/records/save';
import { uniqueSlug } from '../../../lib/slug';

export const prerender = false;

const { supabase, user } = Astro.locals;
const wsSlug = Astro.params.workspace!;

const gate = await requireWrite(
  supabase,
  'cigar-lounge',
  wsSlug,
  user?.id ?? null,
  Astro.url.pathname + Astro.url.search
);
if (!gate.ok) return gate.response;
const workspace = gate.workspace;

const base = `/cigars/${workspace.slug}`;
const today = new Date().toISOString().slice(0, 10);

// Which half of the app the button was pressed on. The humidor adds something
// resting; the log records something smoked. It is one form either way, because
// it is one table — the status just starts in the right place.
const wanted = Astro.url.searchParams.get('status');
const startStatus = wanted === 'humidor' ? 'humidor' : 'smoked';

// Stage zero of the lookup: what this lounge already has. Loaded for the panel
// rather than for the write below, which keeps its own read for the reason
// stated there.
const owned = await loadCigars(supabase, workspace.id);

/**
 * Arriving from the reference page with a cigar already chosen.
 *
 * Only the id travels in the URL, and the row is read here rather than the
 * values being carried across as query parameters — so what lands in the form
 * is what the database holds, and a fiddled link can at worst name a different
 * real reference row. `loadReference` goes through the caller's client, so RLS
 * has already decided they may see it.
 */
const wantedReference = Astro.url.searchParams.get('reference');
const prefill = wantedReference ? await loadReference(supabase, wantedReference) : null;

// Marked so a suggested value looks the same whether it arrived by button or by
// URL. Only the fields actually carrying something — marking a blank would be
// claiming a suggestion nobody made.
const suggested = prefill
  ? (
      [
        prefill.name && 'name',
        prefill.brand && 'brand',
        prefill.vitola && 'vitola',
        prefill.wrapper && 'wrapper',
        prefill.country && 'country',
        prefill.strength && 'strength',
        prefill.length_inches && 'length_text',
        prefill.ring_gauge && 'ring_gauge',
      ].filter(Boolean) as string[]
    )
  : [];

let error: string | null = null;
let submitted: FormData | null = null;

/**
 * The reference row an entry was filled from, if the lookup panel filled it.
 *
 * Read straight off the form rather than through `readCigar`, and deliberately:
 * `readCigar` also serves the edit page, which would then carry this column on
 * every correction and clear it on any form that had never heard of it. This
 * is only ever set once, by the panel, on the page the panel is on.
 *
 * Checked for shape because it goes into a uuid column, where anything else is
 * a 22P02 rather than a sentence.
 */
const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

if (Astro.request.method === 'POST') {
  submitted = await Astro.request.formData();
  const parsed = readCigar(submitted);

  if (!parsed.ok) {
    error = parsed.error;
  } else {
    // Slugs follow the convention the markdown filenames set — dated, so the
    // same cigar smoked twice does not collide. Read the taken ones now rather
    // than at page load, so a slug minted here reflects anything added since.
    const existing = await loadCigars(supabase, workspace.id);
    const slug = uniqueSlug(
      cigarSlug(parsed.values, today),
      existing.map(c => c.id)
    );

    // From the panel's hidden input, or from the ?reference= this page was
    // opened with. The form wins: it is the later of the two and the one the
    // person actually acted on.
    const referenceId =
      String(submitted.get('reference_id') ?? '').trim() || (prefill?.id ?? '');

    const { error: writeError } = await supabase
      .from('cl_cigars')
      .insert({
        workspace_id: workspace.id,
        slug,
        ...parsed.values,
        reference_id: UUID.test(referenceId) ? referenceId : null,
      });

    if (writeError) {
      error = describeWriteError(writeError, 'cl_cigars insert');
    } else {
      return Astro.redirect(parsed.values.status === 'humidor' ? `${base}/humidor` : base);
    }
  }
}
---

<ClLayout title={`Add a cigar · ${workspace.name}`} workspace={workspace}>
  <div class="container">
    <div class="page-header">
      <p class="eyebrow">{startStatus === 'humidor' ? 'To the humidor' : 'To the log'}</p>
      <h1>Add a cigar</h1>
      <p class="subtitle">
        {
          startStatus === 'humidor'
            ? 'Something new to rest. Give it a quantity if there is more than one.'
            : 'One you have smoked. It needs the date, and a rating if you have one.'
        }
      </p>
    </div>

    {error && <p class="form-error" role="alert">{error}</p>}

    <CigarLookup endpoint={`/api/cigars/${workspace.slug}/lookup`} base={base} cigars={owned} />

    {
      prefill && (
        <p class="cigar-form__prefilled">
          Started from a lookup of <strong>{[prefill.brand, prefill.name].filter(Boolean).join(' ')}</strong>.
          The highlighted fields are its suggestions — correct anything it got wrong.
        </p>
      )
    }

    <form method="POST" class="cigar-form">
      <CigarFields
        cigar={null}
        defaults={{
          status: startStatus,
          dateSmoked: startStatus === 'smoked' ? today : '',
          name: prefill?.name,
          brand: prefill?.brand,
          vitola: prefill?.vitola,
          wrapper: prefill?.wrapper,
          country: prefill?.country,
          strength: prefill?.strength ?? undefined,
          // Decimal inches, because that is what the lookup returned. Rendering
          // `4 7/8"` from 4.9 would be writing something nobody said.
          lengthText: prefill?.length_inches ? `${prefill.length_inches}″` : undefined,
          ringGauge: prefill?.ring_gauge ?? undefined,
        }}
        suggested={suggested}
        submitted={submitted}
      />

      {prefill && <input type="hidden" name="reference_id" value={prefill.id} />}

      <div class="cigar-form__actions">
        <button class="cigar-form__submit" type="submit">Add</button>
        <a class="cigar-form__cancel" href={startStatus === 'humidor' ? `${base}/humidor` : base}>
          Cancel
        </a>
      </div>
    </form>
  </div>
</ClLayout>
