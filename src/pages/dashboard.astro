---
import AppShell from '../layouts/AppShell.astro';
import { appBySlug, projectHref } from '../lib/apps';
import { loadEntitlements, describeGrantError } from '../lib/grants';
import type { Returns } from '../lib/database.types';

export const prerender = false;

const { user, supabase } = Astro.locals;
if (!user) return Astro.redirect('/login?next=/dashboard');

// Taking a project off your own list.
//
// Handled before the reads below, so the page that renders is the one that is
// true after it. The launcher and this page are both built from memberships,
// which until now only an owner could remove — being able to put something on
// somebody's front door and not take it off again is a strange amount of
// authority to hand a colleague.
let notice: string | null = null;
let leaveError: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  if (String(form.get('action') ?? '') === 'leave') {
    const { error: e } = await supabase.rpc('leave_workspace', {
      p_workspace: String(form.get('workspace_id') ?? ''),
    });

    if (e) leaveError = describeGrantError(e);
    else notice = String(form.get('name') ?? 'That project') + ' is off your list.';
  }
}

// Set by the settings page on its way out, because the page that would have
// reported it has just been deleted.
const deleted = Astro.url.searchParams.get('deleted');
if (deleted) notice = `${deleted} is gone, along with everything in it.`;

// Which card is asking. Leaving is a confirmation rather than a click for the
// same reason every delete on the site is: it is a stray tap on a phone, and
// the way back into a private project is an invitation you cannot send
// yourself.
const leaving = Astro.url.searchParams.get('leave');

// The `.eq('user_id', …)` is load-bearing, despite RLS. members_read allows
// `user_id = auth.uid() OR workspace_role(workspace_id) IS NOT NULL` — the
// second half exposes the whole roster to anyone in the project, so without
// this filter a project would appear once per member the moment it had two,
// each time labelled with somebody else's role. resolveWorkspace() had the
// same bug and the same fix.
const { data: memberships, error } = await supabase
  .from('workspace_members')
  .select('role, workspaces(id, app, slug, name, description, visibility, external_url)')
  .eq('user_id', user.id)
  .order('created_at', { ascending: true });

// `workspaces` is nullable in the join's type even though the FK is NOT NULL,
// so narrow it once here rather than asserting at each use below.
const rows = (memberships ?? []).flatMap(({ role, workspaces }) =>
  workspaces ? [{ role, ws: workspaces }] : []
);

// Invitations addressed to this account, which is not the same question as
// "invitations this account can read".
//
// Selecting from workspace_invites here was wrong twice over. invites_read
// also allows `app.is_owner(workspace_id)` — the clause the settings page runs
// on — so an owner was shown the invitations they had *sent*, worded as though
// they had received them, with an Accept button accept_invite() answers with
// GRK02. And the project's name came through an embedded join governed by
// workspaces_read, which an invitee fails until the moment they accept, so an
// invitation into a private project arrived with no project attached and fell
// through to the wording for one that grants nothing but the right to create.
//
// my_pending_invites() answers both: scoped to auth.users.email by the same
// rule accept_invite() enforces, and definer, so the name of a project you
// have been invited to is readable before you are in it.
const { data: invites, error: pendingError } = await supabase.rpc('my_pending_invites');

const pending = invites ?? [];

// "Reading List and Cigar Lounge" — and "A, B and C" once there are three,
// which `join(' and ')` got wrong.
const listOf = (items: string[]) =>
  new Intl.ListFormat('en-GB', { style: 'long', type: 'conjunction' }).format(items);

/**
 * What an invitation actually gives you, in one sentence.
 *
 * An invitation does one of three things — joins you to a project, lets you
 * start one of your own, or both — and saying the wrong one is how this
 * section came to read as somebody else's business. `role` is null exactly
 * when there is no project to have a role in, so it is the thing to branch on
 * rather than a workspace name that used to go missing for other reasons.
 */
function offerOf(invite: Returns<'my_pending_invites'>[number]): string {
  const grants = invite.grant_apps.map(a => appBySlug(a)?.name ?? a);
  const parts = [
    invite.role && `joins you as ${invite.role}`,
    grants.length > 0 && `lets you start your own ${listOf(grants)}`,
  ].filter((p): p is string => Boolean(p));

  const offer = parts.join(', and ');
  return offer.charAt(0).toUpperCase() + offer.slice(1);
}

const shortDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long' });

// What this account may start on its own, which is a different question from
// what it is a member of — someone can have one, both, or neither.
const { creatable, isPlatformAdmin } = await loadEntitlements(supabase, user.id);

// Set by /invite/[token] when redemption failed, so the reason can be worded
// here rather than in a redirect.
const inviteFailed = Astro.url.searchParams.get('invite') === 'failed';
const failureReason = Astro.url.searchParams.get('reason');
const inviteError = inviteFailed
  ? describeGrantError({
      code: failureReason ?? undefined,
      message: 'That invitation could not be accepted.',
    })
  : null;
---

<AppShell title="Your projects · Grackles">
  <h1 class="page-title">Your projects</h1>
  <p class="page-intro">
    Everything you own or have been invited to, across every app.
    {' '}<a href="/search">Ask the archive</a> · <a href="/settings/ai">What AI has cost you</a>{isPlatformAdmin && (
      <> · <a href="/admin">Platform</a> · <a href="/admin/people">People</a> · <a href="/admin/ai">AI controls</a></>
    )}.
  </p>

  {notice && <p class="notice notice--ok">{notice}</p>}
  {leaveError && <p class="notice notice--error" role="alert">{leaveError}</p>}
  {error && <p class="notice notice--error" role="alert">Could not load your projects: {error.message}</p>}
  {inviteError && <p class="notice notice--error" role="alert">{inviteError}</p>}
  {
    /* Said out loud rather than swallowed: an invitation that fails to load
       and one that does not exist look identical on a page that shows nothing,
       and the difference is whether somebody is still waiting to be let in. */
    pendingError && (
      <p class="notice notice--error" role="alert">
        Could not check for invitations: {pendingError.message}
      </p>
    )
  }

  {
    pending.length > 0 && (
      <>
        <p class="section-label">Invitations</p>
        <p class="page-intro">Waiting for you. Nobody else can see these.</p>
        <ul class="ws-grid">
          {pending.map(invite => (
            <li>
              <form method="POST" action={`/invite/${invite.token}`}>
                <div class="ws-card">
                  <span class="ws-card__app">
                    {invite.app ? (appBySlug(invite.app)?.name ?? invite.app) : 'Grackles'}
                  </span>
                  {/* An invitation with no project to join is not nameless —
                      it is an offer of one of your own, and the card says so
                      rather than leaving the heading to trail off. */}
                  <span class="ws-card__name">
                    {invite.workspace_name ?? 'A project of your own'}
                  </span>
                  <span class="ws-card__desc">
                    {invite.invited_by_name && `From ${invite.invited_by_name}. `}
                    {offerOf(invite)}.
                  </span>
                  <div class="ws-card__meta">
                    <button class="button" type="submit">
                      Accept
                    </button>
                    <span>Expires {shortDate(invite.expires_at)}</span>
                  </div>
                </div>
              </form>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    creatable.length > 0 && (
      <>
        <p class="section-label">Start something</p>
        <p class="page-intro">
          You can start your own{' '}
          {creatable.map(c => appBySlug(c.app)?.name ?? c.app).join(', ')}.{' '}
          <a href="/new">Set one up</a>.
        </p>
      </>
    )
  }

  <p class="section-label">Projects</p>

  {
    rows.length === 0 ? (
      <div class="empty">
        <p>Nothing here yet.</p>
        <p>Projects you create or are invited to will appear on this page.</p>
      </div>
    ) : (
      <ul class="ws-grid">
        {rows.map(({ role, ws }) => (
          <li class="ws-card">
            {/* The link wraps only the title block — a nested <a> for settings
                would be invalid markup. */}
            <a
              class="ws-card__link"
              href={projectHref(ws)}
              target={ws.external_url ? '_blank' : undefined}
              rel={ws.external_url ? 'noopener' : undefined}
            >
              <span class="ws-card__app">{appBySlug(ws.app)?.name ?? ws.app}</span>
              <span class="ws-card__name">{ws.name}</span>
              {ws.description && <span class="ws-card__desc">{ws.description}</span>}
            </a>
            <span class="ws-card__meta">
              <span class={`tag${role === 'viewer' ? ' tag--viewer' : ''}`}>{role}</span>
              <span class="tag">{ws.visibility}</span>
              {role === 'owner' ? (
                <a class="ws-card__settings" href={`/settings/${appBySlug(ws.app)?.path}/${ws.slug}`}>
                  Settings
                </a>
              ) : leaving === ws.id ? (
                <form method="POST" class="ws-card__leave">
                  <input type="hidden" name="action" value="leave" />
                  <input type="hidden" name="workspace_id" value={ws.id} />
                  <input type="hidden" name="name" value={ws.name} />
                  <button class="ws-card__settings ws-card__leave-yes" type="submit">
                    Leave{ws.visibility === 'private' && ' — you would need a new invitation'}
                  </button>
                  <a class="ws-card__settings" href="/dashboard">Cancel</a>
                </form>
              ) : (
                /* Offered to a member and not to an owner, though the database
                   allows an owner who is not the last one to leave as well. An
                   owner has a settings page, where leaving is a decision taken
                   next to the one about who else owns this. */
                <a class="ws-card__settings" href={`/dashboard?leave=${ws.id}`}>Leave</a>
              )}
            </span>
          </li>
        ))}
      </ul>
    )
  }
</AppShell>
