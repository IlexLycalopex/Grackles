---
import LxLayout from '../../../layouts/LxLayout.astro';
import Word from '../../../components/latam/Word.astro';
import { resolveWorkspace } from '../../../lib/workspace';
import { describeDeleteError, describeWriteError, NOTHING_DELETED } from '../../../lib/records/save';
import { loadSettings } from '../../../lib/latam/latam';
import { makeGlossary, recheckGlossary, type Gloss } from '../../../lib/latam/glossary';
import { instapaperConfigured, sendToInstapaper } from '../../../lib/latam/instapaper';
import { isFetchable } from '../../../lib/latam/page';
import { parseFeed, readingMinutes, TOPIC_LABELS, TOPICS, type Topic } from '../../../../supabase/functions/_shared/reader.ts';

export const prerender = false;

const { supabase, user } = Astro.locals;
const workspace = await resolveWorkspace(supabase, 'latam', Astro.params.workspace!, user?.id ?? null);
if (!workspace) return new Response('Not found', { status: 404 });
if (!user) return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
const base = `/latam/${workspace.slug}`;
const here = `${base}/lecturas${Astro.url.search}`;

const LEVELS = ['A2', 'B1', 'B2', 'C1'] as const;
const RATINGS = [
  { value: 'easy', label: 'too easy' },
  { value: 'right', label: 'about right' },
  { value: 'hard', label: 'too hard' },
] as const;
// The paper's section names, in the paper's language.
const SECCION: Record<Topic, string> = {
  travel: 'Viajes',
  mountains: 'Montaña',
  fishing: 'Pesca con mosca',
  books: 'Libros',
  culture: 'Cine y música',
  drink: 'Vino, cerveza y whisky',
  food: 'Cocina',
};

const settings = await loadSettings(supabase, workspace.id);
const focusTag = (settings?.focus_tag ?? 'argentina').replace(/-/g, ' ').replace(/^./, c => c.toUpperCase());

let error: string | null = null;
let notice: string | null = null;

if (Astro.request.method === 'POST') {
  if (!workspace.canWrite) return new Response('Forbidden', { status: 403 });
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  const field = (k: string) => String(form.get(k) ?? '').trim();

  if (intent === 'feed-add') {
    const url = isFetchable(field('url'));
    const topic = field('topic') as Topic;
    const name = field('name').slice(0, 80);
    if (!url) error = 'That is not an address the site can fetch.';
    else if (!TOPICS.includes(topic)) error = 'Choose a section for the feed.';
    else if (!name) error = 'Give the feed a name to show beside its articles.';
    else {
      // Check it is a feed before saving it: an address that answers with a
      // web page instead would fail silently every night.
      let items = 0;
      try {
        const res = await fetch(url, {
          headers: { 'User-Agent': 'Mozilla/5.0 (compatible; Grackles/1.0; +https://grackles.co.uk)', Accept: 'application/rss+xml, application/atom+xml, application/xml, text/xml' },
          signal: AbortSignal.timeout(8000),
        });
        if (res.ok) items = parseFeed((await res.text()).slice(0, 3_000_000)).length;
      } catch {
        items = 0;
      }
      if (!items) error = 'That address did not answer with an RSS or Atom feed. Look for a link marked RSS on the site.';
      else {
        const { error: e } = await supabase.from('lx_reader_feeds').insert({
          workspace_id: workspace.id,
          url: url.href,
          name,
          topic,
          created_by: user.id,
        });
        if (e?.code === '23505') notice = 'That feed is already on the list.';
        else if (e) error = describeWriteError(e, 'lx_reader_feeds add');
        else notice = `Added ${name}: ${items} items in it now. Its articles arrive with the next fetch.`;
      }
    }
  } else if (intent === 'feed-remove') {
    const { data, error: e } = await supabase.from('lx_reader_feeds').delete().eq('id', field('id')).eq('workspace_id', workspace.id).select('id');
    if (e) error = describeDeleteError(e, 'lx_reader_feeds remove');
    else if (!data?.length) error = NOTHING_DELETED;
    else notice = 'Feed removed. Articles already fetched from it stay.';
  } else if (intent === 'fetch-now') {
    const { error: e } = await supabase.rpc('lx_reader_fetch_now');
    if (e) error = e.code === 'GRK53' ? `Fetched recently: ${e.message}.` : describeWriteError(e, 'lx_reader_fetch_now');
    else notice = 'Fetching now. New articles appear in a minute or two; reload to see them.';
  } else {
    const { data: article } = await supabase.from('lx_reader_articles').select('*').eq('id', field('id')).maybeSingle();
    if (!article) error = 'That article is no longer here.';
    else if (intent === 'glossary') {
      const r = await makeGlossary(supabase, workspace.id, article);
      if (r.ok)
        notice = `Glossary ready for "${article.title}": ${r.words} words.${
          r.dropped.length ? ` Not in the dictionary, so left out: ${r.dropped.join(', ')}.` : ''
        }`;
      else error = r.error;
    } else if (intent === 'check-words') {
      const r = await recheckGlossary(supabase, article);
      if (r.ok)
        notice = `Checked against Wiktionary: ${r.words} kept.${r.dropped.length ? ` Not in the dictionary, so left out: ${r.dropped.join(', ')}.` : ''}`;
      else error = r.error;
    } else if (intent === 'rate') {
      const { error: e } = await supabase.from('lx_reader_marks').upsert(
        { workspace_id: workspace.id, article_id: article.id, rating: field('rating'), created_by: user.id, updated_at: new Date().toISOString() },
        { onConflict: 'workspace_id,article_id' }
      );
      if (e) error = describeWriteError(e, 'lx_reader_marks rate');
    } else if (intent === 'instapaper') {
      if (!workspace.isOwner) error = 'Only the project owner can send to their Instapaper.';
      else {
        const glossary = (Array.isArray(article.glossary) ? article.glossary : []) as unknown as Gloss[];
        const note = [article.summary_en, glossary.map(g => `${g.es}: ${g.checked && g.dict ? g.dict : g.en}`).join('; ')].filter(Boolean).join(' · ');
        const tags = [focusTag, `Spanish ${article.level}`, TOPIC_LABELS[article.topic as Topic] ?? article.topic];
        const sent = await sendToInstapaper(article.url, article.title, note, fetch, tags);
        if (!sent.ok) error = sent.message;
        else {
          await supabase.from('lx_reader_marks').upsert(
            { workspace_id: workspace.id, article_id: article.id, sent_at: new Date().toISOString(), created_by: user.id, updated_at: new Date().toISOString() },
            { onConflict: 'workspace_id,article_id' }
          );
          notice = `Sent to Instapaper${sent.tagged ? `, tagged ${tags.join(', ')}` : ''}.`;
        }
      }
    }
  }
}

const params = Astro.url.searchParams;
const topic = TOPICS.includes(params.get('topic') as Topic) ? (params.get('topic') as Topic) : null;
const levels = params.getAll('level').filter(l => (LEVELS as readonly string[]).includes(l));
const shownLevels = levels.length ? levels : ['B1', 'B2'];

let query = supabase
  .from('lx_reader_articles')
  .select('id, url, source, topic, title, published_at, fetched_at, words, cov5k, level, summary_en, glossary, image_url')
  .not('level', 'is', null)
  .in('level', shownLevels)
  .order('fetched_at', { ascending: false })
  .limit(80);
if (topic) query = query.eq('topic', topic);

const [{ data: articles }, { data: marks }, { data: feeds }, { count: total }] = await Promise.all([
  query,
  supabase.from('lx_reader_marks').select('article_id, rating, sent_at').eq('workspace_id', workspace.id),
  supabase.from('lx_reader_feeds').select('*').eq('workspace_id', workspace.id).order('created_at'),
  supabase.from('lx_reader_articles').select('id', { count: 'exact', head: true }).not('level', 'is', null),
]);
const markOf = new Map((marks ?? []).map(m => [m.article_id, m]));

// The reader's comfort zone: the median five-thousand-word coverage of the
// articles they called about right, once there are three of them.
const { data: rightOnes } = await supabase
  .from('lx_reader_articles')
  .select('cov5k')
  .in('id', (marks ?? []).filter(m => m.rating === 'right').map(m => m.article_id));
const rights = (rightOnes ?? []).map(r => Number(r.cov5k)).filter(Number.isFinite).sort((a, b) => a - b);
const comfort = rights.length >= 3 ? rights[Math.floor(rights.length / 2)]! : null;
const suggested = (cov: number | null) => comfort !== null && cov !== null && Math.abs(Number(cov) - comfort) <= 0.02;

type Row = NonNullable<typeof articles>[number];
const glossaryOf = (a: Row) => (Array.isArray(a.glossary) ? a.glossary : []) as unknown as Gloss[];
const list = (articles ?? []).sort((a, b) => Number(suggested(b.cov5k)) - Number(suggested(a.cov5k)));
// The lead carries a picture, so the front page never opens on an empty
// column: one suggested for this reader, else one with a glossary already
// made, else the newest with a picture; then the rest beneath it.
const lead =
  list.find(a => suggested(a.cov5k) && a.image_url) ??
  list.find(a => glossaryOf(a).length && a.image_url) ??
  list.find(a => a.image_url) ??
  list[0] ??
  null;
const rest = list.filter(a => a !== lead);

const canInstapaper = workspace.isOwner && instapaperConfigured();
const pct = (n: number | null) => (n === null ? '' : `${Math.round(Number(n) * 100)}%`);
const publisher = (a: { source: string; url: string }) => {
  if (a.source !== 'Bing News') return a.source;
  try {
    return new URL(a.url).hostname.replace(/^www\./, '');
  } catch {
    return a.source;
  }
};
const link = (t: Topic | null, ls: string[]) => {
  const q = new URLSearchParams();
  if (t) q.set('topic', t);
  for (const l of ls) q.append('level', l);
  const s = q.toString();
  return `${base}/lecturas${s ? `?${s}` : ''}`;
};
const toggle = (l: string) => (shownLevels.includes(l) ? shownLevels.filter(x => x !== l) : [...shownLevels, l]);
const today = new Date().toLocaleDateString('es-AR', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'America/Argentina/Buenos_Aires' });
---

<LxLayout title={`Lecturas · ${workspace.name}`} workspace={workspace}>
  <header class="lx-head lr-masthead">
    <div>
      <p class="lx-kicker" lang="es">{today} · {total ?? 0} artículos</p>
      <h1>Lecturas</h1>
    </div>
    <p class="lr-standfirst">
      Argentine journalism on your subjects, graded by how much of each piece is common Spanish. Levels are relative
      to the native press, not a textbook.
    </p>
  </header>

  <div class="lr-bar">
    <nav class="lr-sections" aria-label="Section">
      <a href={link(null, levels)} aria-current={!topic ? 'page' : undefined} lang="es">Todo</a>
      {TOPICS.map(t => <a href={link(t, levels)} aria-current={topic === t ? 'page' : undefined} lang="es">{SECCION[t]}</a>)}
    </nav>
    <div class="lr-levels" role="group" aria-label="Level">
      {LEVELS.map(l => (
        <a class={`lr-pill${shownLevels.includes(l) ? ' lr-pill--on' : ''}`} href={link(topic, toggle(l))} aria-pressed={shownLevels.includes(l) ? 'true' : 'false'}>{l}</a>
      ))}
    </div>
  </div>

  {error && <p class="lx-error" role="alert">{error}</p>}
  {notice && <p class="lx-notice" role="status">{notice}</p>}

  {
    !lead ? (
      <p class="lx-empty">Nothing in this section at these levels yet. New articles arrive each morning.</p>
    ) : (
      <section class="lr-lead" aria-label="Lead article">
        <article class="lr-lead__story">
          {lead.image_url && (
            <a href={lead.url} target="_blank" rel="noopener" class="lr-lead__pic" tabindex="-1" aria-hidden="true">
              <img src={lead.image_url} alt="" loading="lazy" referrerpolicy="no-referrer" />
            </a>
          )}
          <p class="lr-kicker">
            <span lang="es">{SECCION[lead.topic as Topic]}</span> · {lead.level} · {publisher(lead)}
            {suggested(lead.cov5k) && <span class="lr-flag">Suggested</span>}
          </p>
          <h2 class="lr-lead__title" lang="es"><a href={lead.url} target="_blank" rel="noopener">{lead.title}</a></h2>
          {lead.summary_en && <p class="lr-lead__summary">{lead.summary_en}</p>}
          <p class="lr-meta">
            {readingMinutes(lead.words)} min · {pct(lead.cov5k)} common words
            {lead.summary_en && ' · summary and glossary by MiniMax'}
          </p>
          <div class="lr-actions">
            <a class="lr-cta" href={lead.url} target="_blank" rel="noopener" lang="es">Leer el artículo</a>
            {canInstapaper && !markOf.get(lead.id)?.sent_at && (
              <form method="post" action={here}>
                <input type="hidden" name="intent" value="instapaper" />
                <input type="hidden" name="id" value={lead.id} />
                <button class="lx-button lx-button--quiet" type="submit">Send to Instapaper</button>
              </form>
            )}
          </div>
        </article>
        <aside class="lr-vocab" aria-label="Vocabulary">
          <h3 lang="es">Vocabulario</h3>
          {
            glossaryOf(lead).length ? (
              <>
                <dl>
                  {glossaryOf(lead).map(g => (
                    <div>
                      <Word word={g} />
                    </div>
                  ))}
                </dl>
                {workspace.canWrite && !glossaryOf(lead).some(g => g.checked !== undefined) && (
                  <form method="post" action={here} data-busy="Checking the dictionary…">
                    <input type="hidden" name="intent" value="check-words" />
                    <input type="hidden" name="id" value={lead.id} />
                    <button class="lr-link" type="submit">Check these against the dictionary</button>
                  </form>
                )}
              </>
            ) : (
              workspace.canWrite && (
                <form method="post" action={here} data-busy>
                  <input type="hidden" name="intent" value="glossary" />
                  <input type="hidden" name="id" value={lead.id} />
                  <p class="lx-hint">Ten words from this article worth knowing, with a two-line summary.</p>
                  <button class="lx-button lx-button--quiet" type="submit">Make the glossary</button>
                </form>
              )
            )
          }
          {workspace.canWrite && (
            <div class="lr-rate">
              <span>After reading, was it</span>
              {RATINGS.map(r => (
                <form method="post" action={here}>
                  <input type="hidden" name="intent" value="rate" />
                  <input type="hidden" name="id" value={lead.id} />
                  <input type="hidden" name="rating" value={r.value} />
                  <button class="lr-rate__btn" type="submit" aria-pressed={markOf.get(lead.id)?.rating === r.value ? 'true' : 'false'}>{r.label}</button>
                </form>
              ))}
            </div>
          )}
        </aside>
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section class="lx-section" aria-labelledby="mas-h">
        <h2 id="mas-h" lang="es">Más lecturas</h2>
        <div class="lr-grid">
          {rest.map(a => {
            const m = markOf.get(a.id);
            const glossary = glossaryOf(a);
            return (
              <article class="lr-card">
                {a.image_url && (
                  <a href={a.url} target="_blank" rel="noopener" class="lr-card__pic" tabindex="-1" aria-hidden="true">
                    <img src={a.image_url} alt="" loading="lazy" referrerpolicy="no-referrer" />
                  </a>
                )}
                <p class="lr-kicker">
                  <span lang="es">{SECCION[a.topic as Topic]}</span> · {a.level}
                  {suggested(a.cov5k) && <span class="lr-flag">Suggested</span>}
                </p>
                <h3 lang="es"><a href={a.url} target="_blank" rel="noopener">{a.title}</a></h3>
                <p class="lr-meta">
                  {publisher(a)} · {readingMinutes(a.words)} min · {pct(a.cov5k)} common words
                  {m?.rating && ` · you said ${RATINGS.find(r => r.value === m.rating)?.label}`}
                  {m?.sent_at && ' · in Instapaper'}
                </p>
                {(a.summary_en || glossary.length > 0) && (
                  <details class="lr-more">
                    <summary>Summary and vocabulary</summary>
                    {a.summary_en && <p>{a.summary_en}</p>}
                    {glossary.length > 0 && (
                      <dl class="lx-words">
                        {glossary.map(g => <Word word={g} />)}
                      </dl>
                    )}
                  </details>
                )}
                {workspace.canWrite && (
                  <div class="lr-card__actions">
                    {!a.summary_en && glossary.length === 0 && (
                      <form method="post" action={here} data-busy>
                        <input type="hidden" name="intent" value="glossary" />
                        <input type="hidden" name="id" value={a.id} />
                        <button class="lr-link" type="submit">Glossary</button>
                      </form>
                    )}
                    {glossary.length > 0 && !glossary.some(g => g.checked !== undefined) && (
                      <form method="post" action={here} data-busy="Checking…">
                        <input type="hidden" name="intent" value="check-words" />
                        <input type="hidden" name="id" value={a.id} />
                        <button class="lr-link" type="submit">Check words</button>
                      </form>
                    )}
                    {canInstapaper && !m?.sent_at && (
                      <form method="post" action={here}>
                        <input type="hidden" name="intent" value="instapaper" />
                        <input type="hidden" name="id" value={a.id} />
                        <button class="lr-link" type="submit">Instapaper</button>
                      </form>
                    )}
                    {RATINGS.map(r => (
                      <form method="post" action={here}>
                        <input type="hidden" name="intent" value="rate" />
                        <input type="hidden" name="id" value={a.id} />
                        <input type="hidden" name="rating" value={r.value} />
                        <button class="lr-link" type="submit" aria-pressed={m?.rating === r.value ? 'true' : 'false'}>{r.label}</button>
                      </form>
                    ))}
                  </div>
                )}
              </article>
            );
          })}
        </div>
      </section>
    )
  }

  <p class="lx-hint">
    {
      comfort !== null
        ? `Your comfort zone: articles where about ${pct(comfort)} of the words are among the 5,000 commonest. Those are marked Suggested.`
        : 'Mark three articles "about right" and the page starts choosing for your level.'
    }
  </p>

  {
    workspace.canWrite && (
      <section class="lx-section" aria-labelledby="feeds-h">
        <div class="lx-section__head">
          <h2 id="feeds-h">Your feeds</h2>
          <form method="post" action={here}>
            <input type="hidden" name="intent" value="fetch-now" />
            <button class="lx-button lx-button--quiet" type="submit">Fetch now</button>
          </form>
        </div>
        <p class="lx-hint">
          Built in: Clarín, La Nación, Infobae, Río Negro, and Bing News searches for fishing, climbing and drink. Add any
          RSS or Atom feed; its articles go through the same filters and grading. Headlines about crime, politics,
          disasters and the like are always left out.
        </p>
        {(feeds ?? []).length > 0 && (
          <ul class="lx-list">
            {(feeds ?? []).map(f => (
              <li class="lx-row">
                <div>
                  <div class="lx-row__title">{f.name}</div>
                  <div class="lx-row__meta">
                    <span lang="es">{SECCION[f.topic as Topic]}</span>
                    <span style="word-break: break-all;">{f.url}</span>
                    {f.last_run_at ? (
                      <span class={f.last_ok ? '' : 'lx-error'}>{f.last_message}</span>
                    ) : (
                      <span>not fetched yet</span>
                    )}
                  </div>
                </div>
                <form method="post" action={here} class="lx-row__side">
                  <input type="hidden" name="intent" value="feed-remove" />
                  <input type="hidden" name="id" value={f.id} />
                  <button class="lx-button lx-button--quiet" type="submit" aria-label={`Remove ${f.name}`}>Remove</button>
                </form>
              </li>
            ))}
          </ul>
        )}
        <form method="post" action={here} class="lx-form">
          <input type="hidden" name="intent" value="feed-add" />
          <div class="lx-field" style="flex: 2 1 320px">
            <label for="feed-url">Feed address</label>
            <input id="feed-url" name="url" type="url" required placeholder="https://www.example.com.ar/feed/" />
          </div>
          <div class="lx-field">
            <label for="feed-name">Name</label>
            <input id="feed-name" name="name" required maxlength="80" placeholder="Revista Weekend" />
          </div>
          <div class="lx-field" style="flex: 1 1 180px">
            <label for="feed-topic">Section</label>
            <select id="feed-topic" name="topic">{TOPICS.map(t => <option value={t}>{TOPIC_LABELS[t]}</option>)}</select>
          </div>
          <button class="lx-button" type="submit">Add feed</button>
        </form>
      </section>
    )
  }

  <p class="lx-hint">
    Pictures are each article's own, shown from its publisher. Glossaries are chosen by MiniMax and each word is checked to
    be in the article; meanings come from Wiktionary, porteño and lunfardo senses first, with MiniMax's note on the
    word in context beneath. Word frequencies from FrequencyWords (CC BY-SA 4.0).
  </p>

  <script>
    document.querySelectorAll<HTMLFormElement>('form[data-busy]').forEach(f =>
      f.addEventListener('submit', () => {
        const b = f.querySelector('button');
        if (b) {
          b.disabled = true;
          b.textContent = f.dataset.busy || 'Reading the article…';
        }
      })
    );
  </script>
</LxLayout>
