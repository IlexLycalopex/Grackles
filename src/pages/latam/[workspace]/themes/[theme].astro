---
import LxLayout from '../../../../layouts/LxLayout.astro';
import { resolveWorkspace } from '../../../../lib/workspace';
import { describeDeleteError, describeWriteError, NOTHING_DELETED } from '../../../../lib/records/save';
import { loadSettings, minutes } from '../../../../lib/latam/latam';
import { instapaperConfigured, sendToInstapaper } from '../../../../lib/latam/instapaper';
import { minutesForTag, type Item } from '../../../../lib/latam/places';

export const prerender = false;

const { supabase, user } = Astro.locals;
const workspace = await resolveWorkspace(supabase, 'latam', Astro.params.workspace!, user?.id ?? null);
if (!workspace) return new Response('Not found', { status: 404 });
const base = `/latam/${workspace.slug}`;

const { data: theme } = await supabase
  .from('lx_themes')
  .select('*')
  .eq('workspace_id', workspace.id)
  .eq('slug', Astro.params.theme!)
  .maybeSingle();
if (!theme) return new Response('Not found', { status: 404 });
const here = `${base}/themes/${theme.slug}`;

let error: string | null = null;
let notice: string | null = null;

if (Astro.request.method === 'POST') {
  if (!user) return Astro.redirect(`/login?next=${encodeURIComponent(here)}`);
  if (!workspace.canWrite) return new Response('Forbidden', { status: 403 });
  const form = await Astro.request.formData();
  const intent = String(form.get('intent') ?? '');
  const field = (k: string) => String(form.get(k) ?? '').trim();

  if (intent === 'item-add') {
    const url = field('url');
    const { error: e } = await supabase.from('lx_items').insert({
      workspace_id: workspace.id,
      theme_id: theme.id,
      kind: field('kind'),
      title: field('title').slice(0, 300),
      creator: field('creator').slice(0, 200),
      url: /^https?:\/\//.test(url) ? url : '',
    });
    if (e?.code === '23505') notice = 'That is already on the list.';
    else if (e) error = describeWriteError(e, 'lx_items add');
    else notice = 'Added.';
  } else if (intent === 'item-done') {
    const { data, error: e } = await supabase
      .from('lx_items')
      .update({ done: field('done') === 'true' })
      .eq('id', field('id'))
      .eq('theme_id', theme.id)
      .select('id');
    if (e) error = describeWriteError(e, 'lx_items done');
    else if (!data?.length) error = 'Nothing was changed. Your role may have changed.';
  } else if (intent === 'instapaper') {
    const { data: it } = await supabase.from('lx_items').select('title, url, why').eq('id', field('id')).eq('theme_id', theme.id).maybeSingle();
    if (!workspace.isOwner) error = 'Only the project owner can send to their Instapaper.';
    else if (!it) error = 'That item is no longer there.';
    else {
      const sent = await sendToInstapaper(it.url, it.title, it.why);
      if (sent.ok) notice = `Sent ${it.title} to Instapaper.`;
      else error = sent.message;
    }
  } else if (intent === 'item-delete') {
    const { data, error: e } = await supabase.from('lx_items').delete().eq('id', field('id')).eq('theme_id', theme.id).select('id');
    if (e) error = describeDeleteError(e, 'lx_items delete');
    else if (!data?.length) error = NOTHING_DELETED;
  }
}

const settings = await loadSettings(supabase, workspace.id);
const [{ data: itemRows }, time] = await Promise.all([
  supabase.from('lx_items').select('*').eq('theme_id', theme.id).order('done').order('created_at'),
  minutesForTag(supabase, workspace.id, settings?.jpod_workspace_id ?? null, theme.slug),
]);
const items: Item[] = itemRows ?? [];
const KINDS = ['book', 'film', 'podcast', 'article', 'other'];
const canInstapaper = workspace.isOwner && instapaperConfigured();
---

<LxLayout title={`${theme.name} · ${workspace.name}`} workspace={workspace}>
  <header class="lx-head">
    <div>
      <p class="lx-kicker"><a href={`${base}/themes`}>Themes</a></p>
      <h1>{theme.name}</h1>
      <p class="lx-lede">{theme.summary}</p>
      <p class="lx-hint">Tag <code>{theme.slug}</code> · {minutes(time.latam)} logged · {minutes(time.podcasts)} podcasts</p>
    </div>
  </header>

  {error && <p class="lx-error" role="alert">{error}</p>}
  {notice && <p class="lx-notice" role="status">{notice}</p>}

  <section class="lx-section">
    {
      items.length === 0 ? (
        <p class="lx-empty">Nothing on this list yet.</p>
      ) : (
        <ul class="lx-list">
          {items.map(it => (
            <li class="lx-row">
              <div>
                <div class={`lx-row__title${it.done ? ' lx-done' : ''}`}>
                  {it.url ? <a href={it.url} rel="noopener">{it.title}</a> : it.title}
                  {it.creator && `, ${it.creator}`}
                </div>
                <div class="lx-row__meta">
                  <span class="lx-status">{it.kind}</span>
                  {it.why && <span>{it.why}</span>}
                </div>
              </div>
              {workspace.canWrite && (
                <div class="lx-actions">
                  <form method="post">
                    <input type="hidden" name="intent" value="item-done" />
                    <input type="hidden" name="id" value={it.id} />
                    <input type="hidden" name="done" value={String(!it.done)} />
                    <button class="lx-button lx-button--quiet" type="submit">{it.done ? 'Not done' : 'Done'}</button>
                  </form>
                  {canInstapaper && it.url && (it.kind === 'article' || it.kind === 'other') && (
                    <form method="post">
                      <input type="hidden" name="intent" value="instapaper" />
                      <input type="hidden" name="id" value={it.id} />
                      <button class="lx-button lx-button--quiet" type="submit">Instapaper</button>
                    </form>
                  )}
                  <form method="post">
                    <input type="hidden" name="intent" value="item-delete" />
                    <input type="hidden" name="id" value={it.id} />
                    <button class="lx-button lx-button--quiet" type="submit" aria-label={`Remove ${it.title}`}>Remove</button>
                  </form>
                </div>
              )}
            </li>
          ))}
        </ul>
      )
    }
    {
      workspace.canWrite && (
        <form method="post" class="lx-form">
          <input type="hidden" name="intent" value="item-add" />
          <div class="lx-field" style="flex: 0 1 140px">
            <label for="kind">Kind</label>
            <select id="kind" name="kind">{KINDS.map(k => <option value={k}>{k}</option>)}</select>
          </div>
          <div class="lx-field">
            <label for="title">Title</label>
            <input id="title" name="title" required maxlength="300" />
          </div>
          <div class="lx-field">
            <label for="creator">By</label>
            <input id="creator" name="creator" maxlength="200" />
          </div>
          <div class="lx-field">
            <label for="url">Link</label>
            <input id="url" name="url" type="url" />
          </div>
          <button class="lx-button" type="submit">Add</button>
        </form>
      )
    }
  </section>
</LxLayout>
