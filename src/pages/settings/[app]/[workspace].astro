---
import AppShell from '../../../layouts/AppShell.astro';
import { HOSTED_APPS, appByPath, appBySlug, projectHref } from '../../../lib/apps';
import { resolveWorkspace } from '../../../lib/workspace';
import { slugify } from '../../../lib/slug';
import { loadEntitlements } from '../../../lib/grants';
import { sendInviteEmail } from '../../../lib/email';
import { loadCalls, loadJobs, money, spentToday } from '../../../lib/ai/usage';
import { FEATURES } from '../../../lib/ai/features';
import type { AppSlug, MemberRole, Visibility } from '../../../lib/database.types';

export const prerender = false;

const { supabase, user } = Astro.locals;
const { app: appPath, workspace: wsSlug } = Astro.params;

const app = appByPath(appPath!);
if (!app) return new Response('Not found', { status: 404 });

let workspace = await resolveWorkspace(supabase, app.slug, wsSlug!, user?.id ?? null);
if (!workspace) return new Response('Not found', { status: 404 });

if (!user) return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
// Members can read this page's data, but only owners have any business here.
if (!workspace.isOwner) return new Response('Forbidden', { status: 403 });

const ROLES: MemberRole[] = ['owner', 'editor', 'viewer'];
const VISIBILITIES: Visibility[] = ['private', 'unlisted', 'public'];

// Mirrors workspaces_description_length. Checked here so a long one comes back
// as a sentence, and in the database because that is what guarantees it.
const SUBTITLE_MAX = 200;

// Not a database rule, unlike the one above: `workspaces.name` is only checked
// for being non-empty. This is the length at which a name stops fitting in the
// launcher, which is the place it has to fit.
const NAME_MAX = 80;

// Only a platform admin may attach creation rights to an invitation — the RLS
// policy on workspace_invites enforces it, and an owner who tried would have
// the insert refused. Reading the flag here is what keeps the control off the
// page for everyone else rather than offering something that cannot work.
const { isPlatformAdmin } = await loadEntitlements(supabase, user.id);

let error: string | null = null;
let notice: string | null = null;

// Holds a rejected value so the box re-renders what was typed rather than what
// is stored. Losing a sentence someone just composed, in order to tell them it
// was four characters too long, is the worst way to report that.
let subtitleDraft: string | null = null;
let nameDraft: string | null = null;
let addressDraft: string | null = null;
let elsewhereDraft: string | null = null;

/**
 * What a write actually did.
 *
 * Every update on this page asks for the row back and checks it got one, for
 * the reason the subtitle already had to learn: a write refused by row-level
 * security does not raise, it narrows the statement to zero rows and reports
 * success. Without this an owner demoted mid-session is told the change saved
 * while the page carries on showing the old value.
 */
const saved = (rows: unknown[] | null, e: { message: string } | null): string | null => {
  if (e) return e.message;
  if (!rows?.length) return 'Nothing was changed — you may no longer own this project.';
  return null;
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const str = (k: string) => String(form.get(k) ?? '').trim();

  if (action === 'invite') {
    const email = str('email').toLowerCase();
    const role = ROLES.includes(str('role') as MemberRole) ? (str('role') as MemberRole) : 'viewer';

    // Creation rights are a separate grant from membership, and only an admin
    // can give them. Filtering here rather than trusting the form means a
    // hand-posted `grant_apps` from an owner is dropped before the insert,
    // which turns an RLS refusal into simply not happening.
    const grantApps = isPlatformAdmin
      ? form.getAll('grant_apps').map(String).filter((a): a is AppSlug =>
          HOSTED_APPS.some(known => known.slug === a)
        )
      : [];

    if (!email) {
      error = 'Enter an email address to invite.';
    } else {
      // The token comes back from the insert because it is what the email is
      // for. It is generated by a column default, so there is nothing to send
      // until the row exists.
      const { data: created, error: e } = await supabase
        .from('workspace_invites')
        .insert({
          workspace_id: workspace.id,
          email,
          role,
          grant_apps: grantApps,
          invited_by: user.id,
        })
        .select('token, expires_at, grant_apps')
        .single();

      // The partial unique index only allows one un-accepted invite per
      // address, so a repeat is a duplicate rather than a failure.
      if (e?.code === '23505') {
        error = `${email} already has an invitation waiting.`;
      } else if (e) {
        error = e.message;
      } else {
        const sent = await sendInviteEmail({
          to: email,
          inviteUrl: `${Astro.url.origin}/invite/${created.token}`,
          workspaceName: workspace.name,
          appName: app.name,
          role,
          invitedBy: user.email!,
          expiresAt: created.expires_at,
          grantedApps: (created.grant_apps ?? []).map(a => appBySlug(a)?.name ?? a),
        });

        // A send that fails leaves a perfectly good invitation behind, so this
        // reports rather than rolls back: the link is on the page below and
        // passing it on by hand still works.
        notice = sent.ok
          ? `Invited ${email} as ${role} — the invitation is on its way.`
          : `Invited ${email} as ${role}, but the email could not be sent (${sent.reason}). Send them the link below instead.`;
      }
    }
  }

  if (action === 'resend') {
    // Recovering from a failed send without revoking and starting again, which
    // would change the token and break a link that may already have been sent.
    const { data: invite, error: e } = await supabase
      .from('workspace_invites')
      .select('email, role, token, expires_at, grant_apps')
      .eq('id', str('invite_id'))
      // This project's invitations only. An owner of two projects can read
      // both lists, and the mail below names this one.
      .eq('workspace_id', workspace.id)
      .is('accepted_at', null)
      .maybeSingle();

    if (e || !invite) {
      error = 'That invitation is no longer pending.';
    } else {
      const sent = await sendInviteEmail({
        to: invite.email,
        inviteUrl: `${Astro.url.origin}/invite/${invite.token}`,
        workspaceName: workspace.name,
        appName: app.name,
        role: invite.role,
        invitedBy: user.email!,
        expiresAt: invite.expires_at,
        grantedApps: (invite.grant_apps ?? []).map(a => appBySlug(a)?.name ?? a),
      });

      if (sent.ok) notice = `Invitation to ${invite.email} sent again.`;
      else error = `Could not send to ${invite.email}: ${sent.reason}`;
    }
  }

  if (action === 'revoke') {
    const { data: rows, error: e } = await supabase
      .from('workspace_invites')
      .delete()
      .eq('id', str('invite_id'))
      .eq('workspace_id', workspace.id)
      .select('id');
    error = saved(rows, e);
    if (!error) notice = 'Invitation revoked.';
  }

  if (action === 'set-role') {
    const role = str('role') as MemberRole;
    if (!ROLES.includes(role)) {
      error = 'That is not one of the roles.';
    } else {
      const { data: rows, error: e } = await supabase
        .from('workspace_members')
        .update({ role })
        .eq('workspace_id', workspace.id)
        .eq('user_id', str('user_id'))
        .select('user_id');
      // guard_last_owner() raises rather than letting a workspace end up with
      // nobody able to administer it.
      error = saved(rows, e);
      if (!error) notice = 'Role updated.';
    }
  }

  if (action === 'remove') {
    const { data: rows, error: e } = await supabase
      .from('workspace_members')
      .delete()
      .eq('workspace_id', workspace.id)
      .eq('user_id', str('user_id'))
      .select('user_id');
    error = saved(rows, e);
    if (!error) notice = 'Member removed.';
  }

  if (action === 'set-name') {
    const name = str('name');

    if (!name) {
      error = 'A project has to have a name.';
    } else if (name.length > NAME_MAX) {
      error = `That name is ${name.length} characters. Keep it under ${NAME_MAX} so it fits in the menu.`;
      nameDraft = name;
    } else {
      const { data: rows, error: e } = await supabase
        .from('workspaces')
        .update({ name })
        .eq('id', workspace.id)
        .select('name');

      error = saved(rows, e);
      if (error) nameDraft = name;
      else {
        notice = 'Name saved.';
        workspace = { ...workspace, name };
      }
    }
  }

  if (action === 'set-address') {
    // Slugified rather than validated, the same way /new does it: the check
    // constraint on the column would refuse 'Rob's Lounge' with a constraint
    // name, and what somebody meant by typing it is 'robs-lounge'.
    const slug = slugify(str('slug'));

    if (!slug) {
      error = 'That address has no letters or numbers in it, so there is nothing to make an address out of.';
    } else if (slug === workspace.slug) {
      notice = 'That is already the address.';
    } else {
      const { data: rows, error: e } = await supabase
        .from('workspaces')
        .update({ slug })
        .eq('id', workspace.id)
        .select('slug');

      if (e?.code === '23505') {
        error = `/${app.path}/${slug} belongs to another project.`;
        addressDraft = slug;
      } else {
        error = saved(rows, e);

        if (error) {
          addressDraft = slug;
        } else {
          // This page's own URL carries the old address, so there is nowhere
          // to render the result. The old one forwards from here on, which is
          // what the notice on the other side says.
          return Astro.redirect(
            `/settings/${app.path}/${slug}?moved=${encodeURIComponent(workspace.slug)}`
          );
        }
      }
    }
  }

  if (action === 'set-elsewhere') {
    const external = str('external_url');

    // Mirrors workspaces_external_url_shape, so a mistyped address comes back
    // as a sentence rather than a constraint name.
    if (external && !/^https?:\/\//.test(external)) {
      error = 'An address somewhere else has to start with http:// or https://.';
      elsewhereDraft = external;
    } else if (!external && !app.hosted) {
      // Clearing it on an app with no routes here does not bring a project
      // home, it points every link at a page that does not exist.
      error = `Grackles has no pages for ${app.name} yet, so this project has to say where it is.`;
      elsewhereDraft = external;
    } else {
      const { data: rows, error: e } = await supabase
        .from('workspaces')
        .update({ external_url: external })
        .eq('id', workspace.id)
        .select('external_url');

      error = saved(rows, e);
      if (error) elsewhereDraft = external;
      else {
        notice = external
          ? 'Every link to this project now goes there.'
          : `This project is now served from here, at /${app.path}/${workspace.slug}.`;
        workspace = { ...workspace, external_url: external };
      }
    }
  }

  if (action === 'delete-project') {
    // Typed, not clicked. This is the one control on the site that destroys
    // records nobody can get back, and a button that only needs a click is one
    // stray tap on a phone away from doing it.
    if (str('confirm').toLowerCase() !== workspace.slug) {
      error = `Type ${workspace.slug} to confirm, or cancel.`;
    } else {
      const { data: rows, error: e } = await supabase
        .from('workspaces')
        .delete()
        .eq('id', workspace.id)
        .select('id');

      error = saved(rows, e);
      if (!error) {
        return Astro.redirect(`/dashboard?deleted=${encodeURIComponent(workspace.name)}`);
      }
    }
  }

  if (action === 'set-description') {
    // Trimmed by str(), so a box someone cleared saves as '' — which is the
    // stored value for "no subtitle" and what the card checks before it
    // renders the line at all. Clearing it is a supported edit, not an error.
    const description = str('description');

    if (description.length > SUBTITLE_MAX) {
      error = `That subtitle is ${description.length} characters. The limit is ${SUBTITLE_MAX}.`;
      subtitleDraft = description;
    } else {
      const { data: rows, error: e } = await supabase
        .from('workspaces')
        .update({ description })
        .eq('id', workspace.id)
        .select('description');

      error = saved(rows, e);

      if (error) {
        subtitleDraft = description;
      } else {
        notice = description ? 'Subtitle saved.' : 'Subtitle removed.';
        workspace = { ...workspace, description };
      }
    }
  }

  if (action === 'set-ai') {
    // One row per feature, upserted. An absent row means the feature's own
    // defaults apply, so saving a form that changes nothing still writes — that
    // is the point at which "the default" becomes "a decision somebody made".
    const feature = str('feature');
    const daily = str('daily_usd');
    const parsedDaily = daily === '' ? null : Number(daily);

    if (parsedDaily !== null && (!Number.isFinite(parsedDaily) || parsedDaily < 0)) {
      error = 'A daily limit has to be a number, or empty for none.';
    } else {
      // Consent is recorded as a moment and a person, not as a boolean. "Who
      // agreed, and when" is the question that gets asked afterwards, and a
      // true/false cannot answer it.
      const consenting = form.get('consent') !== null;

      // Read here rather than from the page's own list, which is loaded after
      // this block runs. Consent already given keeps its original timestamp:
      // saving the panel again is not a fresh agreement, and overwriting the
      // date would erase when the decision was actually taken.
      const { data: existing } = await supabase
        .from('ai_workspace_features')
        .select('consent_at, consent_by')
        .eq('workspace_id', workspace.id)
        .eq('feature', feature)
        .maybeSingle();

      const { error: e } = await supabase
        .from('ai_workspace_features')
        .upsert({
          workspace_id: workspace.id,
          feature,
          enabled: form.get('enabled') !== null,
          consent_at: consenting
            ? (existing?.consent_at ?? new Date().toISOString())
            : null,
          consent_by: consenting ? (existing?.consent_by ?? user.id) : null,
          daily_usd: parsedDaily,
          // Meaningless unless the project is public, and refused at admission
          // in that case. The control below is disabled rather than hidden,
          // because a switch that silently does nothing is worse than one that
          // says why it cannot.
          allow_anon: form.get('allow_anon') !== null && workspace.visibility === 'public',
        }, { onConflict: 'workspace_id,feature' });

      error = e?.message ?? null;
      if (!e) notice = 'AI settings saved.';
    }
  }

  if (action === 'set-visibility') {
    const visibility = str('visibility') as Visibility;
    if (!VISIBILITIES.includes(visibility)) {
      error = 'Unknown visibility.';
    } else {
      const { error: e } = await supabase
        .from('workspaces')
        .update({ visibility })
        .eq('id', workspace.id);
      error = e?.message ?? null;
      if (!e) {
        notice = `This project is now ${visibility}.`;
        workspace = (await resolveWorkspace(supabase, app.slug, wsSlug!, user?.id ?? null)) ?? workspace;
      }
    }
  }
}

// Arriving back from a change of address, which redirected because this page's
// own URL was the thing that moved.
const movedFrom = Astro.url.searchParams.get('moved');
if (!notice && movedFrom) {
  notice = `Address changed. /${app.path}/${movedFrom} forwards here from now on.`;
}

// The confirmation step lives at ?delete=1 on this page, the same shape every
// record in the three apps uses, and for the same reason: a GET that deletes is
// one link prefetcher away from emptying a humidor.
const confirmingDelete = Astro.url.searchParams.get('delete') === '1';

/**
 * How much is in there, for the sentence above the confirmation box.
 *
 * The same case expression admin_projects() carries, asked one app at a time.
 * Takes its arguments rather than closing over `workspace` and `app`, which
 * are a reassigned `let` and a narrowed lookup — neither of which narrows
 * inside a function body.
 *
 * Three apps return null rather than a number. The four still served from
 * GitHub Pages hold nothing here, and Blackletter holds games that
 * `bl_games_read` shows you only your own of — a count that says 3 when the
 * project holds 300 is worse on this particular page than no count at all.
 */
async function holdings(w: string, of: AppSlug): Promise<{ n: number; noun: string } | null> {
  const opts = { count: 'exact' as const, head: true };

  switch (of) {
    case 'reading-list': {
      const { count } = await supabase.from('rl_books').select('id', opts).eq('workspace_id', w);
      return { n: count ?? 0, noun: 'readings' };
    }
    case 'cigar-lounge': {
      const { count } = await supabase.from('cl_cigars').select('id', opts).eq('workspace_id', w);
      return { n: count ?? 0, noun: 'entries' };
    }
    case 'listening-party': {
      const { count } = await supabase.from('lp_selections').select('id', opts).eq('workspace_id', w);
      return { n: count ?? 0, noun: 'picks' };
    }
    case 'wbpr': {
      const { count } = await supabase.from('wbpr_broadcasts').select('id', opts).eq('workspace_id', w);
      return { n: count ?? 0, noun: 'broadcasts' };
    }
    case 'commonplace': {
      // Decks are the project's; progress is each person's own and goes with
      // them, so the count that matters before a delete is the decks.
      const { count } = await supabase.from('cp_decks').select('id', opts).eq('workspace_id', w);
      return { n: count ?? 0, noun: 'flashcard decks' };
    }
    default:
      return null;
  }
}

const held = confirmingDelete ? await holdings(workspace.id, app.slug) : null;

// Old addresses that would stop forwarding with it. Read here rather than
// described in the abstract, because "and its two old addresses" is the line
// that stops somebody deleting the project they meant to rename.
const { count: forwardingCount } = confirmingDelete
  ? await supabase
      .from('workspace_slug_history')
      .select('slug', { count: 'exact', head: true })
      .eq('workspace_id', workspace.id)
  : { count: 0 };

const { data: members } = await supabase
  .from('workspace_members')
  .select('user_id, role, profiles(display_name, email)')
  .eq('workspace_id', workspace.id);

const { data: invites } = await supabase
  .from('workspace_invites')
  .select('id, email, role, token, expires_at, grant_apps')
  .eq('workspace_id', workspace.id)
  .is('accepted_at', null);

const origin = Astro.url.origin;
const ownerCount = (members ?? []).filter(m => m.role === 'owner').length;

// ── What AI has cost this project ────────────────────────────────────────
// Only the features that belong to this app: a Cigar Lounge has no business
// showing the desk's switches.
const appFeatures = FEATURES.filter(f => f.app === app.slug);

// Which of them transmit stored records rather than something just typed. The
// answer is currently none, and the control only appears for the ones that do.
const { data: featureRows } = appFeatures.length
  ? await supabase
      .from('ai_features')
      .select('key, sends_records')
      .in('key', appFeatures.map(f => f.key))
  : { data: [] };

const sendsRecords = new Set(
  (featureRows ?? []).filter(f => f.sends_records).map(f => f.key)
);

const { data: aiSwitches } = appFeatures.length
  ? await supabase
      .from('ai_workspace_features')
      .select('feature, enabled, daily_usd, allow_anon, consent_at, consent_by')
      .eq('workspace_id', workspace.id)
  : { data: [] };

const switchFor = (key: string) =>
  (aiSwitches ?? []).find(s => s.feature === key);

const [aiJobs, aiCalls, aiToday] = appFeatures.length
  ? await Promise.all([
      loadJobs(supabase, { workspaceId: workspace.id, limit: 10 }),
      loadCalls(supabase, { workspaceId: workspace.id, limit: 10 }),
      spentToday(supabase, workspace.id),
    ])
  : [[], [], 0];

const aiMonth = aiJobs.reduce((sum, j) => sum + Number(j.spent_usd), 0);
const aiChecked = aiCalls.filter(c => c.validator_status !== null);
const aiFailedChecks = aiChecked.filter(c => c.validator_status === 'fail').length;
---

<AppShell title={`${workspace.name} settings · Grackles`}>
  <h1 class="page-title">{workspace.name}</h1>
  <p class="page-intro">
    {app.name} · <a href={projectHref(workspace)}>open the project</a>
  </p>

  {error && <p class="notice notice--error" role="alert">{error}</p>}
  {notice && <p class="notice notice--ok">{notice}</p>}

  <p class="section-label">Name</p>
  <form method="POST" class="inline-form">
    <input type="hidden" name="action" value="set-name" />
    <input
      class="field__input"
      type="text"
      name="name"
      maxlength={NAME_MAX}
      value={nameDraft ?? workspace.name}
      required
    />
    <button class="button" type="submit">Save</button>
  </form>
  <p class="page-intro">
    What this project is called on the launcher, on everybody's dashboard and in an invitation.
    Changing it changes nothing else: the address below stays as it is.
  </p>

  <p class="section-label">Address</p>
  <form method="POST" class="inline-form">
    <input type="hidden" name="action" value="set-address" />
    <span class="address__prefix">/{app.path}/</span>
    <input
      class="field__input"
      type="text"
      name="slug"
      value={addressDraft ?? workspace.slug}
      required
    />
    <button class="button" type="submit">Save</button>
  </form>
  <p class="page-intro">
    Tidied to lower case, letters, numbers and hyphens, so <em>Rob's Lounge</em> becomes
    <em>robs-lounge</em>. The old address keeps working — it forwards here, along with anything
    below it, so a link somebody has written down is not broken by tidying one up.
  </p>

  <p class="section-label">Where it lives</p>
  <form method="POST" class="inline-form">
    <input type="hidden" name="action" value="set-elsewhere" />
    <input
      class="field__input"
      type="url"
      name="external_url"
      placeholder="https://example.com/"
      value={elsewhereDraft ?? workspace.external_url}
    />
    <button class="button" type="submit">Save</button>
  </form>
  <p class="page-intro">
    {
      app.hosted ? (
        <>
          Empty means this project is served from here, at{' '}
          <em>/{app.path}/{workspace.slug}</em>. A URL points every link at that instead, which
          is what to set while a site is being moved in or rolled back — the project, its members
          and its address survive either way.
        </>
      ) : (
        <>
          Grackles has no pages for {app.name} yet, so this is where the project actually is.
          Every link to it opens there, in a new tab. Clearing this is what brings it home, on
          the day it has somewhere here to come home to.
        </>
      )
    }
  </p>

  <p class="section-label">Subtitle</p>
  <form method="POST" class="inline-form">
    <input type="hidden" name="action" value="set-description" />
    <textarea
      class="field__input"
      name="description"
      rows="2"
      maxlength={SUBTITLE_MAX}
      placeholder="One line about this project"
      aria-describedby="subtitle-help">{subtitleDraft ?? workspace.description}</textarea>
    <button class="button" type="submit">Save</button>
  </form>
  <p class="page-intro" id="subtitle-help">
    The line under the name on the dashboard. Leave it empty for none.
    {
      /* True of the Listening Party and nowhere else: the Reading List and
         Cigar Lounge build their page descriptions from what they contain, so
         claiming this reaches search results there would be wrong. */
      app.slug === 'listening-party' && (
        <>
          {' '}
          It is also what search results and link previews show for this
          project, on any page where a season has not given its own.
        </>
      )
    }
  </p>

  <p class="section-label">Who can see this</p>
  <form method="POST" class="inline-form">
    <input type="hidden" name="action" value="set-visibility" />
    <select class="field__input field__input--auto" name="visibility">
      {
        VISIBILITIES.map(v => (
          <option value={v} selected={workspace.visibility === v}>
            {v}
          </option>
        ))
      }
    </select>
    <button class="button" type="submit">Update</button>
  </form>
  <p class="page-intro">
    <strong>private</strong> — members only. <strong>unlisted</strong> — anyone with the link.
    <strong>public</strong> — readable by anyone, and indexed by search engines.
  </p>

  <p class="section-label">Members</p>
  <ul class="member-list">
    {
      (members ?? []).map(m => (
        <li class="member">
          <div class="member__who">
            <span class="member__name">{m.profiles?.display_name || m.profiles?.email}</span>
            <span class="member__email">{m.profiles?.email}</span>
          </div>
          <form method="POST" class="inline-form">
            <input type="hidden" name="action" value="set-role" />
            <input type="hidden" name="user_id" value={m.user_id} />
            <select class="field__input field__input--auto" name="role">
              {ROLES.map(r => (
                <option value={r} selected={m.role === r}>
                  {r}
                </option>
              ))}
            </select>
            <button class="button button--quiet" type="submit">Save</button>
          </form>
          {
            /* Removing the only owner would orphan the project. The database
               refuses it too; hiding the button avoids the error entirely. */
            !(m.role === 'owner' && ownerCount === 1) && (
              <form method="POST">
                <input type="hidden" name="action" value="remove" />
                <input type="hidden" name="user_id" value={m.user_id} />
                <button class="button button--danger" type="submit">Remove</button>
              </form>
            )
          }
        </li>
      ))
    }
  </ul>

  <p class="section-label">Invite someone</p>
  <form method="POST" class="inline-form">
    <input type="hidden" name="action" value="invite" />
    <input class="field__input" type="email" name="email" placeholder="their@email.com" required />
    <select class="field__input field__input--auto" name="role">
      <option value="viewer" selected>viewer</option>
      <option value="editor">editor</option>
      <option value="owner">owner</option>
    </select>
    <button class="button" type="submit">Invite</button>
  </form>
  <p class="page-intro">
    A <strong>viewer</strong> can read everything and change nothing — that is the read-only
    collaboration case.
  </p>

  {
    /* Two different things, deliberately on one invitation: joining this
       project, and being able to start one of your own. Inviting someone as a
       viewer here says nothing about whether they can run their own lounge —
       that is what these boxes are for. Admin-only, matching the RLS rule. */
    isPlatformAdmin && (
      <>
        <p class="section-label">…and let them start their own</p>
        <form method="POST" class="inline-form">
          <input type="hidden" name="action" value="invite" />
          <input
            class="field__input"
            type="email"
            name="email"
            placeholder="their@email.com"
            required
          />
          <select class="field__input field__input--auto" name="role">
            <option value="viewer" selected>
              viewer
            </option>
            <option value="editor">editor</option>
            <option value="owner">owner</option>
          </select>
          <button class="button" type="submit">Invite</button>
          <span class="grant-picker">
            {HOSTED_APPS.map(a => (
              <label class="grant-picker__option">
                <input type="checkbox" name="grant_apps" value={a.slug} />
                {a.name}
              </label>
            ))}
          </span>
        </form>
        <p class="page-intro">
          The invitation still adds them to <strong>{workspace.name}</strong> with the role
          chosen above. Anything ticked additionally lets them create a project of their own in
          that app — one each.
        </p>
      </>
    )
  }

  {
    (invites ?? []).length > 0 && (
      <>
        <p class="section-label">Pending invitations</p>
        <ul class="member-list">
          {(invites ?? []).map(inv => (
            <li class="member">
              <div class="member__who">
                <span class="member__name">{inv.email}</span>
                <span class="member__email">
                  {inv.role} · expires {new Date(inv.expires_at).toLocaleDateString('en-GB')}
                  {inv.grant_apps.length > 0 &&
                    ` · may start their own ${inv.grant_apps
                      .map(a => appBySlug(a)?.name ?? a)
                      .join(', ')}`}
                </span>
                {/* The invitation is emailed on creation. The link stays here
                    because it is the fallback when a send fails, and because
                    passing it on by hand is sometimes simply quicker. */}
                <input
                  class="field__input member__link"
                  type="text"
                  readonly
                  value={`${origin}/invite/${inv.token}`}
                  onclick="this.select()"
                />
              </div>
              <form method="POST">
                <input type="hidden" name="action" value="resend" />
                <input type="hidden" name="invite_id" value={inv.id} />
                <button class="button button--quiet" type="submit">Send again</button>
              </form>
              <form method="POST">
                <input type="hidden" name="action" value="revoke" />
                <input type="hidden" name="invite_id" value={inv.id} />
                <button class="button button--danger" type="submit">Revoke</button>
              </form>
            </li>
          ))}
        </ul>
      </>
    )
  }
  {
    appFeatures.length > 0 && (
      <>
        <p class="section-label">AI</p>
        <p class="page-intro">
          What this project has spent, and the switches that bound it. The bill is
          yours — every feature here is billed to you as the owner, whoever pressed
          the button. <a href="/settings/ai">Your whole month is here.</a>
        </p>

        <div class="ai-panel">
          <span><strong>{money(aiMonth)}</strong> across recent jobs</span>
          <span><strong>{money(aiToday)}</strong> today</span>
          <span>
            {aiChecked.length > 0
              ? <>{aiFailedChecks} of the last {aiChecked.length} checked calls failed their check</>
              : <>nothing checked yet</>}
          </span>
        </div>

        {appFeatures.map(feature => {
          const current = switchFor(feature.key);
          return (
            <form method="POST" class="ai-feature">
              <input type="hidden" name="action" value="set-ai" />
              <input type="hidden" name="feature" value={feature.key} />
              <div class="ai-feature__head">
                <strong>{feature.key}</strong>
                <span class="page-intro">{feature.what}</span>
              </div>
              <label class="grant-picker__option">
                <input type="checkbox" name="enabled" checked={current?.enabled ?? true} />
                on for this project
              </label>
              <label class="grant-picker__option">
                daily limit $
                <input
                  class="field__input field__input--auto"
                  type="number" step="0.01" min="0" name="daily_usd"
                  value={current?.daily_usd ?? ''}
                  placeholder="none"
                />
              </label>
              {sendsRecords.has(feature.key) && (
                <label class="grant-picker__option" title="This feature sends the project's stored records to a third party. Nothing runs until somebody agrees to that.">
                  <input
                    type="checkbox" name="consent"
                    checked={Boolean(current?.consent_at)}
                  />
                  may send this project's records
                </label>
              )}
              <label class="grant-picker__option" title={
                workspace.visibility === 'public'
                  ? 'Anyone who can read this project may run it, at your expense.'
                  : 'Only a public project can offer anything to strangers.'
              }>
                <input
                  type="checkbox" name="allow_anon"
                  checked={current?.allow_anon ?? false}
                  disabled={workspace.visibility !== 'public'}
                />
                strangers may run it
              </label>
              <button class="button button--quiet" type="submit">Save</button>
            </form>
          );
        })}

        {aiJobs.length > 0 && (
          <ul class="member-list">
            {aiJobs.map(job => (
              <li class="member">
                <div class="member__who">
                  <span class="member__name">{job.feature}</span>
                  <span class="member__email">
                    {new Date(job.created_at).toLocaleString('en-GB', {
                      day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit',
                    })} · {job.status} · {job.calls_made} call{job.calls_made === 1 ? '' : 's'} · {money(Number(job.spent_usd))}
                  </span>
                </div>
                {(job.status === 'running' || job.status === 'queued') && (
                  <form method="POST" action="/api/ai/cancel" class="inline-form">
                    <input type="hidden" name="job_id" value={job.id} />
                    <input type="hidden" name="next" value={Astro.url.pathname} />
                    <button class="button button--quiet" type="submit">Cancel</button>
                  </form>
                )}
              </li>
            ))}
          </ul>
        )}
      </>
    )
  }

  <p class="section-label" id="delete">Delete this project</p>
  {
    confirmingDelete ? (
      <form method="POST" action="?delete=1#delete" class="danger">
        <p>
          <strong>{workspace.name}</strong> and everything in it:
          {held && <> its {held.n} {held.noun},</>}
          {' '}
          {(members ?? []).length} membership{(members ?? []).length === 1 ? '' : 's'},
          {(invites ?? []).length > 0 && <> {(invites ?? []).length} pending invitation{(invites ?? []).length === 1 ? '' : 's'},</>}
          {(forwardingCount ?? 0) > 0 && <> {forwardingCount} old address{(forwardingCount ?? 0) === 1 ? '' : 'es'} that forward here,</>}
          {' '}and its AI history. This cannot be undone, and nobody — including whoever runs
          Grackles — can get it back.
        </p>
        <p>
          {/* ai_periods is keyed on the payer, not the project, and does not
              cascade. Said here because the opposite is the obvious guess, and
              guessing it is how somebody deletes a project expecting an
              allowance back. */}
          What it has already spent still counts against this month's allowance. That is kept
          per person rather than per project, so deleting this does not return any of it.
        </p>
        {
          /* Worth saying out loud on the five that have not moved in: this
             deletes the project, not the site. Blackletter shows no count for
             a different reason — see holdings() — and is hosted, so it does
             not get this line. */
          !app.hosted && (
            <p>
              The site itself is not ours to delete. {workspace.external_url} stays exactly
              where it is; what goes is its place on the launcher and everybody's way in.
            </p>
          )
        }
        <input type="hidden" name="action" value="delete-project" />
        <label class="field">
          <span class="field__label">Type {workspace.slug} to confirm</span>
          <input
            class="field__input"
            type="text"
            name="confirm"
            autocomplete="off"
            autocapitalize="none"
            spellcheck={false}
            required
          />
        </label>
        <div class="inline-form">
          <button class="button button--danger" type="submit">Delete {workspace.name}</button>
          <a class="button button--quiet" href={`/settings/${app.path}/${workspace.slug}`}>Cancel</a>
        </div>
      </form>
    ) : (
      <p class="page-intro">
        {app.hosted
          ? 'Every record in it goes too, and it is not recoverable.'
          : 'This takes the project off Grackles. The site it points at stays where it is.'}{' '}
        <a href="?delete=1#delete">Delete this project</a>.
        {(members ?? []).length > 1 && ' Everybody else loses it as well.'}
      </p>
    )
  }
</AppShell>

<style>
  /* The address is one field with a fixed prefix, not two: what is editable
     and what is not should not look alike. */
  .address__prefix {
    font-size: 0.9rem;
    opacity: 0.7;
    white-space: nowrap;
  }
  .danger {
    border: 1px solid var(--danger);
    border-radius: 2px;
    padding: 1rem;
    max-width: var(--measure);
  }
  .danger p { font-size: 0.9rem; margin-bottom: 1rem; }
  .danger .field { margin-bottom: 1rem; }
  .ai-panel {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }
  .ai-feature {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  .ai-feature__head { display: flex; flex-direction: column; min-width: 14rem; }
  .ai-feature__head .page-intro { margin: 0; font-size: 0.8rem; }
  .ai-feature input[type="number"] { width: 6rem; }
  /* A control that cannot apply says so by looking like it, rather than by
     vanishing and leaving somebody wondering where the setting went. */
  .ai-feature input:disabled { opacity: 0.4; }
  .ai-feature input:disabled + * { opacity: 0.4; }
</style>
