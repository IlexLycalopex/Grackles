---
import AdminConsole from '../../../components/admin/AdminConsole.astro';
import PeopleList from '../../../components/admin/PeopleList.astro';
import {
  isAdmin, notFound, handleAction, personName, appName, when, sortProjects, projectKind, ROLES,
  type Outcome,
} from '../../../lib/admin/console';
import { findDuplicates } from '../../../lib/admin/duplicates';
import { HOSTED_APPS, projectHref } from '../../../lib/apps';
import { money } from '../../../lib/ai/usage';

export const prerender = false;

/**
 * One person, and everything they can reach, each fact with its control
 * beside it. Roles and allowances save as soon as they change; removing
 * somebody from a project asks first.
 */

const { supabase, user } = Astro.locals;
if (!(await isAdmin(supabase, user))) return notFound();

let outcome: Outcome | null = null;
if (Astro.request.method === 'POST') {
  outcome = await handleAction(supabase, user!, await Astro.request.formData(), Astro.url.origin);
  if (outcome.redirect) return Astro.redirect(outcome.redirect);
}

const personId = Astro.params.id!;
const [{ data: people }, { data: memberships }, { data: projects }, { data: invites }] = await Promise.all([
  supabase.rpc('admin_people'),
  supabase.rpc('admin_person_projects', { p_user: personId }),
  supabase.rpc('admin_projects'),
  supabase.rpc('admin_invites'),
]);

const person = (people ?? []).find(p => p.id === personId);
if (!person) return notFound();

const name = personName(person);
const isSelf = person.id === user!.id;
const twins = findDuplicates(people ?? []).get(person.id) ?? [];
const inIt = new Set((memberships ?? []).map(m => m.workspace_id));
const joinable = sortProjects((projects ?? []).filter(p => !inIt.has(p.id)));
const waiting = (invites ?? []).filter(i => i.email.toLowerCase() === person.email.toLowerCase());
const mine = sortProjects((memberships ?? []).map(m => ({ ...m, id: m.workspace_id })));
---

<AdminConsole title={name} tab="people" outcome={outcome}>
  <div class="adm-split adm-split--open">
    <PeopleList people={people ?? []} current={person.id} />

    <section class="adm-panel">
      <a class="adm-back" href="/admin/people">← Everyone</a>
      <div class="adm-panel__head">
        <h2 class="adm-panel__title">
          {name}
          {person.is_admin && <span class="adm-chip adm-chip--admin">admin</span>}
        </h2>
        <div class="adm-panel__meta">
          <span>{person.email}</span>
          <span>joined {when(person.created_at)}</span>
          {isSelf && <span>this is you</span>}
        </div>
      </div>

      {twins.length > 0 && (
        <p class="adm-attention">
          This may be the same person as{' '}
          {twins.map((t, i) => (
            <>{i > 0 && ', '}<a href={`/admin/people/${t.id}`}>{personName(t)}</a> ({t.email})</>
          ))}. If one account is not used, withdraw its access below.
        </p>
      )}

      <div class="adm-section">
        <h3 class="adm-section__label">Projects</h3>
        {mine.length === 0 ? (
          <p class="adm-hint">Not in any project.</p>
        ) : (
          <div class="adm-rows">
            {mine.map(m => (
              <div class="adm-row">
                <div class="adm-row__what">
                  <a href={`/admin/projects/${m.workspace_id}`}>{m.name}</a>
                  <span class="adm-item__sub">
                    {[projectKind(m), m.visibility].filter(Boolean).join(' · ')}
                    {m.created_it && ' · started it'} · since {when(m.joined_at)}
                  </span>
                </div>
                <div class="adm-row__controls">
                  <form method="POST">
                    <input type="hidden" name="action" value="member-role" />
                    <input type="hidden" name="workspace_id" value={m.workspace_id} />
                    <input type="hidden" name="user_id" value={person.id} />
                    <select class="adm-select" name="role" data-autosave data-focus={`role-${m.workspace_id}`}
                            aria-label={`Role in ${m.name}`}>
                      {ROLES.map(r => <option value={r} selected={m.role === r}>{r}</option>)}
                    </select>
                    <noscript><button class="adm-btn" type="submit">Set</button></noscript>
                  </form>
                  <form method="POST" data-confirm={`Remove ${name} from ${m.name}?`}>
                    <input type="hidden" name="action" value="member-remove" />
                    <input type="hidden" name="workspace_id" value={m.workspace_id} />
                    <input type="hidden" name="user_id" value={person.id} />
                    <button class="adm-btn adm-btn--danger" type="submit">Remove</button>
                  </form>
                  <a class="adm-btn" href={projectHref(m)}>Open</a>
                </div>
              </div>
            ))}
          </div>
        )}

        {joinable.length > 0 && (
          <form method="POST" class="adm-form__row">
            <input type="hidden" name="action" value="member-add" />
            <input type="hidden" name="user_id" value={person.id} />
            <label class="field">
              <span class="field__label">Add to</span>
              <select class="field__input" name="workspace_id" required>
                {joinable.map(p => (
                  <option value={p.id}>{p.name}{projectKind(p) && ` (${projectKind(p)})`}</option>
                ))}
              </select>
            </label>
            <label class="field field--narrow">
              <span class="field__label">As</span>
              <select class="field__input" name="role">
                {ROLES.map(r => <option value={r}>{r}</option>)}
              </select>
            </label>
            <button class="adm-btn adm-btn--solid" type="submit">Add</button>
          </form>
        )}
        <p class="adm-hint">Takes effect straight away; there is no invitation to accept.</p>
      </div>

      <div class="adm-section">
        <h3 class="adm-section__label">May start their own</h3>
        {person.is_admin ? (
          <p class="adm-hint">Anything. Admins have no limit.</p>
        ) : (
          <>
            <div class="adm-rows">
              {HOSTED_APPS.map(a => (
                <div class="adm-row">
                  <span class="adm-row__what">{a.name}</span>
                  <form method="POST" class="adm-row__controls">
                    <input type="hidden" name="action" value="grant" />
                    <input type="hidden" name="user_id" value={person.id} />
                    <input type="hidden" name="app" value={a.slug} />
                    <input class="adm-input" type="number" min="0" max="20" name="max" data-autosave
                           data-focus={`grant-${a.slug}`}
                           value={person.grants?.[a.slug] ?? 0} aria-label={`How many ${a.name} projects`} />
                    <noscript><button class="adm-btn" type="submit">Set</button></noscript>
                  </form>
                </div>
              ))}
            </div>
            <p class="adm-hint">How many they may start. 0 means none; projects they already started count towards it.</p>
          </>
        )}
      </div>

      <div class="adm-section">
        <h3 class="adm-section__label">AI</h3>
        <p>
          {person.ai_monthly_usd === null
            ? 'No AI allowance.'
            : `${money(Number(person.ai_monthly_usd))} a month${person.ai_enabled ? '' : ', switched off'}.`}
          {Number(person.ai_spend_usd) > 0 && ` ${money(Number(person.ai_spend_usd))} spent this month.`}
          {' '}<a href="/admin/ai">Change on the AI tab</a>
        </p>
      </div>

      <div class="adm-section">
        <h3 class="adm-section__label">Platform admin</h3>
        <form method="POST" class="adm-row__controls">
          <input type="hidden" name="action" value="admin" />
          <input type="hidden" name="user_id" value={person.id} />
          <label class="adm-check">
            <input type="checkbox" name="is_admin" checked={person.is_admin} data-autosave />
            Can manage everything in this console
          </label>
          <noscript><button class="adm-btn" type="submit">Save</button></noscript>
        </form>
        {isSelf && person.is_admin && <p class="adm-hint">Unticking this signs you out of the console.</p>}
      </div>

      {waiting.length > 0 && (
        <div class="adm-section">
          <h3 class="adm-section__label">Invitations waiting</h3>
          <div class="adm-rows">
            {waiting.map(i => (
              <div class="adm-row">
                <span class="adm-row__what">
                  {i.workspace_name ? `${i.workspace_name} as ${i.role}` : 'No project'}
                  {i.grant_apps.length > 0 && ` · may start ${i.grant_apps.map(appName).join(', ')}`}
                  <span class="adm-item__sub">expires {when(i.expires_at)}</span>
                </span>
                <form method="POST" data-confirm="Revoke this invitation?">
                  <input type="hidden" name="action" value="revoke-invite" />
                  <input type="hidden" name="invite_id" value={i.id} />
                  <button class="adm-btn adm-btn--danger" type="submit">Revoke</button>
                </form>
              </div>
            ))}
          </div>
        </div>
      )}
    </section>
  </div>
</AdminConsole>
