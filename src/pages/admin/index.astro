---
import AdminConsole from '../../components/admin/AdminConsole.astro';
import { isAdmin, notFound, handleAction, personName, when, type Outcome } from '../../lib/admin/console';
import { findDuplicates } from '../../lib/admin/duplicates';
import { money } from '../../lib/ai/usage';

export const prerender = false;

/**
 * The console's front page: the numbers, and anything that wants doing.
 *
 * "Needs attention" is deliberately short. It lists only things with a clear
 * next step — two accounts that look like one person and both still hold
 * something, an invitation that expired unaccepted — because a list that is
 * never empty is a list nobody reads.
 */

const { supabase, user } = Astro.locals;
if (!(await isAdmin(supabase, user))) return notFound();

let outcome: Outcome | null = null;
if (Astro.request.method === 'POST') {
  outcome = await handleAction(supabase, user!, await Astro.request.formData(), Astro.url.origin);
  if (outcome.redirect) return Astro.redirect(outcome.redirect);
}

const [{ data: overview }, { data: people }, { data: invites }] = await Promise.all([
  supabase.rpc('admin_overview'),
  supabase.rpc('admin_people'),
  supabase.rpc('admin_invites'),
]);
const totals = overview?.[0];
type P = NonNullable<typeof people>[number];

// Somebody holds something if they are in a project or may start one. An old
// account holding nothing is harmless, and flagging it for ever would teach
// the admin to ignore this list.
const holds = (p: P) => p.memberships > 0 || Object.values(p.grants ?? {}).some(n => n > 0);

const seen = new Set<string>();
const duplicates: [P, P][] = [];
for (const [id, twins] of findDuplicates(people ?? [])) {
  const a = (people ?? []).find(p => p.id === id)!;
  for (const b of twins) {
    const pair = [a.id, b.id].sort().join();
    if (seen.has(pair) || !(holds(a) && holds(b))) continue;
    seen.add(pair);
    duplicates.push([a, b]);
  }
}

const expired = (invites ?? []).filter(i => new Date(i.expires_at) < new Date());
const newest = [...(people ?? [])].sort((a, b) => b.created_at.localeCompare(a.created_at)).slice(0, 3);
---

<AdminConsole title="Overview" tab="overview" outcome={outcome}>
  {totals && (
    <div class="adm-stats">
      <a class="adm-stat" href="/admin/people">
        <span class="adm-stat__value">{totals.people}</span>
        <span class="adm-stat__label">people · {totals.admins} admin{totals.admins === 1 ? '' : 's'}</span>
      </a>
      <a class="adm-stat" href="/admin/projects">
        <span class="adm-stat__value">{totals.projects}</span>
        <span class="adm-stat__label">projects · {totals.public_projects} public</span>
      </a>
      <a class="adm-stat" href="/admin/access">
        <span class="adm-stat__value">{totals.memberships}</span>
        <span class="adm-stat__label">memberships</span>
      </a>
      <a class="adm-stat" href="/admin/invitations">
        <span class="adm-stat__value">{totals.pending_invites}</span>
        <span class="adm-stat__label">invitations waiting</span>
      </a>
      <a class="adm-stat" href="/admin/ai">
        <span class="adm-stat__value">{money(Number(totals.ai_spend_usd))}</span>
        <span class="adm-stat__label">AI this month{totals.ai_jobs_running > 0 && ` · ${totals.ai_jobs_running} running`}</span>
      </a>
    </div>
  )}

  <div class="adm-overview">
    <section class="adm-section">
      <h2 class="adm-section__label">Needs attention</h2>
      {duplicates.length === 0 && expired.length === 0 ? (
        <p class="adm-hint">Nothing. Duplicate accounts and expired invitations will show up here.</p>
      ) : (
        <ul class="adm-list-plain">
          {duplicates.map(([a, b]) => (
            <li class="adm-attention">
              <a href={`/admin/people/${a.id}`}><strong>{personName(a)}</strong></a> and{' '}
              <a href={`/admin/people/${b.id}`}><strong>{personName(b)}</strong></a> may be the same person
              ({a.email} and {b.email}). Both still have access. Withdraw it from the account they do not use.
            </li>
          ))}
          {expired.length > 0 && (
            <li class="adm-attention">
              {expired.length} invitation{expired.length === 1 ? ' has' : 's have'} expired without being accepted.{' '}
              <a href="/admin/invitations">Resend or revoke</a>
            </li>
          )}
        </ul>
      )}
    </section>

    <section class="adm-section">
      <h2 class="adm-section__label">Quick actions</h2>
      <div class="adm-quick">
        <a class="adm-btn adm-btn--solid" href="/admin/people">Add or invite someone</a>
        <a class="adm-btn" href="/admin/access">Change who can see what</a>
        <a class="adm-btn" href="/admin/projects">Add a link</a>
      </div>
      <h2 class="adm-section__label" style="margin-top:1rem">Newest accounts</h2>
      <ul class="adm-list-plain">
        {newest.map(p => (
          <li>
            <a href={`/admin/people/${p.id}`}>{personName(p)}</a>
            <span class="adm-hint"> · joined {when(p.created_at)} · {p.memberships} project{p.memberships === 1 ? '' : 's'}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>
</AdminConsole>
