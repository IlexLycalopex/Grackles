---
import LpLayout from '../../../layouts/LpLayout.astro';
import AlbumLinks from '../../../components/lp/AlbumLinks.astro';
import { resolveWorkspace } from '../../../lib/workspace';
import { groupByArtist, loadAllSelections, loadContributors, loadSeasons } from '../../../lib/listening-party';

export const prerender = false;

const { supabase, user } = Astro.locals;
const wsSlug = Astro.params.workspace!;

const workspace = await resolveWorkspace(supabase, 'listening-party', wsSlug, user?.id ?? null);
if (!workspace) return new Response('Not found', { status: 404 });

const [seasons, contributors, allSelections] = await Promise.all([
  loadSeasons(supabase, workspace.id),
  loadContributors(supabase, workspace.id),
  loadAllSelections(supabase, workspace.id),
]);

const base = `/lp/${workspace.slug}`;

// Detail lives in a pre-built modal per artist rather than its own route —
// the same trade the old site made, and it keeps a click from costing a
// round trip.
const artists = groupByArtist(allSelections).map(a => ({
  ...a,
  picks: [...a.picks].sort((x, y) => x.yearSlot - y.yearSlot),
  contribs: [...new Map(a.picks.map(p => [p.contributor.id, p.contributor])).values()],
  seasonSlugs: [...new Set(a.picks.map(p => p.seasonSlug))].filter(Boolean).sort(),
}));
---

<LpLayout
  title={`Artists | ${workspace.name}`}
  description={`${artists.length} artists across all seasons`}
  workspace={workspace}
  seasons={seasons}
  contributors={contributors}
>
  <div class="page-hero">
    <div class="container">
      <a href={base} class="artist-detail__back">
        <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
      </a>
      <h1 class="page-hero__title">Artists</h1>
      <p class="page-hero__sub">{artists.length} artists · all seasons</p>
    </div>
  </div>

  <main>
    <div class="container">
      <div class="artists-grid">
        {
          artists.map(a => (
            <button class="artist-card" type="button" data-modal={`artist-${a.slug}`} aria-haspopup="dialog">
              <span class="artist-card__name">{a.name}</span>
              <div class="artist-card__footer">
                <span class="artist-card__count">
                  {a.picks.length} pick{a.picks.length !== 1 ? 's' : ''}
                </span>
                <span class="artist-card__contribs">
                  {a.contribs.map(c => (
                    <span class="artist-card__contrib-dot" style={`background:${c.color}`} title={c.name} />
                  ))}
                </span>
              </div>
            </button>
          ))
        }
      </div>
    </div>
  </main>

  {
    artists.map(a => (
      <div class="notes-modal" id={`artist-${a.slug}`} hidden aria-hidden="true">
        <div class="notes-modal__backdrop" data-close-modal />
        <div class="notes-modal__box notes-modal__box--wide" role="dialog" aria-modal="true" aria-label={`Picks by ${a.name}`}>
          <div class="notes-modal__header">
            <div class="notes-modal__meta">
              <div class="notes-modal__album">{a.name}</div>
              <div class="notes-modal__byline">
                {a.picks.length} pick{a.picks.length !== 1 ? 's' : ''} · {a.seasonSlugs.join(' · ')}
              </div>
            </div>
            <button class="notes-modal__close" data-close-modal aria-label="Close" type="button">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="18" y1="6" x2="6" y2="18" />
                <line x1="6" y1="6" x2="18" y2="18" />
              </svg>
            </button>
          </div>
          <div class="notes-modal__picks">
            {a.picks.map(pick => (
              <div class="pick-row">
                <div class="pick-row__artwork">
                  {pick.artworkUrl ? (
                    <img src={pick.artworkUrl} alt={pick.album} loading="lazy" />
                  ) : (
                    <div class="pick-row__artwork-placeholder">
                      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.2">
                        <circle cx="12" cy="12" r="9" />
                        <circle cx="12" cy="12" r="3" />
                      </svg>
                    </div>
                  )}
                </div>
                <div class="pick-row__info">
                  <div class="pick-row__album">{pick.album}</div>
                  <div class="pick-row__meta">
                    <span>{pick.yearSlot}</span>
                    <span>·</span>
                    <span class="pick-row__contributor">
                      <span class="pick-row__dot" style={`background:${pick.contributor.color}`} />
                      {pick.contributor.name}
                    </span>
                    <span>·</span>
                    <a href={`${base}/${pick.seasonSlug}`} class="pick-row__season-tag">
                      {pick.seasonSlug}
                    </a>
                  </div>
                </div>
                <div class="pick-row__links">
                  <AlbumLinks album={pick.album} artist={pick.artist} links={pick.links} />
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    ))
  }
</LpLayout>
