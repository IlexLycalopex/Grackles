---
import LpLayout from '../../../../layouts/LpLayout.astro';
import SelectionFields from '../../../../components/lp/SelectionFields.astro';
import { requireWrite } from '../../../../lib/workspace';
import { loadContributors, loadSeasons, loadSelection } from '../../../../lib/listening-party';
import { readSelection } from '../../../../lib/records/selection';
import { describeWriteError } from '../../../../lib/records/save';

export const prerender = false;

const { supabase, user } = Astro.locals;
const { workspace: wsSlug, selection: selectionId } = Astro.params;

const gate = await requireWrite(
  supabase,
  'listening-party',
  wsSlug!,
  user?.id ?? null,
  Astro.url.pathname + Astro.url.search
);
if (!gate.ok) return gate.response;
const workspace = gate.workspace;

const [seasons, contributors] = await Promise.all([
  loadSeasons(supabase, workspace.id),
  loadContributors(supabase, workspace.id),
]);

let pick = await loadSelection(supabase, selectionId!);
if (!pick) return new Response('Not found', { status: 404 });

const base = `/lp/${workspace.slug}`;
let error: string | null = null;
let submitted: FormData | null = null;

if (Astro.request.method === 'POST') {
  submitted = await Astro.request.formData();
  const parsed = readSelection(submitted);

  if (!parsed.ok) {
    error = parsed.error;
  } else {
    const { error: writeError } = await supabase
      .from('lp_selections')
      .update(parsed.values)
      .eq('id', pick.id);

    if (writeError) {
      error = describeWriteError(writeError, 'lp_selections update');
    } else {
      // The season is editable now, so a pick can be moved between them.
      return Astro.redirect(
        `${base}/${seasons.find(s => s.id === parsed.values.season_id)?.slug ?? pick.seasonSlug}#now-playing`
      );
    }
  }

  // Re-read so the page around the form describes what is actually stored. The
  // form itself keeps showing the rejected submission — see `submitted`.
  pick = (await loadSelection(supabase, pick.id)) ?? pick;
}
---

<LpLayout
  title={`Week ${pick.week} | ${workspace.name}`}
  workspace={workspace}
  seasons={seasons}
  contributors={contributors}
>
  <div class="page-hero">
    <div class="container">
      <a href={`${base}/${pick.seasonSlug}`} class="artist-detail__back">
        <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back to {pick.seasonSlug}
      </a>
      <h1 class="page-hero__title">Week {pick.week}</h1>
      <p class="page-hero__sub">
        <span class="pick-row__dot" style={`background:${pick.contributor.color}`}></span>
        {pick.contributor.name} · {pick.yearSlot}
      </p>
    </div>
  </div>

  <main>
    <div class="container">
      {error && <p class="form-error" role="alert">{error}</p>}

      <form method="POST" class="pick-form">
        <SelectionFields
          pick={pick}
          seasons={seasons}
          contributors={contributors}
          submitted={submitted}
        />

        <div class="pick-form__actions">
          <button class="pick-form__submit" type="submit">Save week {pick.week}</button>
          <a class="pick-form__cancel" href={`${base}/${pick.seasonSlug}`}>Cancel</a>
        </div>
      </form>
    </div>
  </main>
</LpLayout>
