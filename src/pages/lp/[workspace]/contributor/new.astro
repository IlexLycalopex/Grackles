---
import LpLayout from '../../../../layouts/LpLayout.astro';
import { fieldValue } from '../../../../lib/forms';
import { requireWrite } from '../../../../lib/workspace';
import { loadContributors, loadSeasons } from '../../../../lib/listening-party';
import { readContributor } from '../../../../lib/records/contributor';
import { describeWriteError } from '../../../../lib/records/save';

export const prerender = false;

const { supabase, user } = Astro.locals;
const wsSlug = Astro.params.workspace!;

const gate = await requireWrite(
  supabase,
  'listening-party',
  wsSlug,
  user?.id ?? null,
  Astro.url.pathname + Astro.url.search
);
if (!gate.ok) return gate.response;
const workspace = gate.workspace;

const base = `/lp/${workspace.slug}`;

const [seasons, contributors] = await Promise.all([
  loadSeasons(supabase, workspace.id),
  loadContributors(supabase, workspace.id),
]);

// Jamie, Nick and Chris are #e8a87c, #7ca8e8 and #7ce8a8 — the same three
// pastel components in rotation. Continuing that series means a new person
// looks like they belong rather than arriving in whatever the colour picker
// opens on. Colours already in use are skipped so two dots never match.
const PALETTE = ['#e8a87c', '#7ca8e8', '#7ce8a8', '#e87ca8', '#a87ce8', '#a8e87c'];
const taken = new Set(contributors.map(c => c.color.toLowerCase()));
const suggested = PALETTE.find(c => !taken.has(c)) ?? PALETTE[contributors.length % PALETTE.length]!;

let error: string | null = null;
let submitted: FormData | null = null;

if (Astro.request.method === 'POST') {
  submitted = await Astro.request.formData();
  const parsed = readContributor(submitted);

  if (!parsed.ok) {
    error = parsed.error;
  } else {
    const { error: writeError } = await supabase
      .from('lp_contributors')
      .insert({ workspace_id: workspace.id, ...parsed.values });

    if (writeError) {
      error = describeWriteError(writeError, 'lp_contributors insert');
    } else {
      return Astro.redirect(`${base}/contributors/${parsed.values.slug}`);
    }
  }
}

const v = (key: string, fallback: string | number = '') =>
  fieldValue(submitted, key, undefined, fallback);
---

<LpLayout
  title={`Add someone | ${workspace.name}`}
  workspace={workspace}
  seasons={seasons}
  contributors={contributors}
>
  <div class="page-hero">
    <div class="container">
      <a href={base} class="artist-detail__back">
        <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor">
          <path d="M10 3L5 8l5 5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Back
      </a>
      <h1 class="page-hero__title">Add someone</h1>
      <p class="page-hero__sub">
        Somebody who picks albums. They do not need an account — picks have to be attributable
        before anyone signs up.
      </p>
    </div>
  </div>

  <main>
    <div class="container">
      {error && <p class="form-error" role="alert">{error}</p>}

      <form method="POST" class="pick-form">
        <label class="pick-form__field">
          <span class="pick-form__label">Name</span>
          <input class="pick-form__input" type="text" name="name" value={v('name')} required autofocus />
        </label>

        <div class="pick-form__row">
          <label class="pick-form__field">
            <span class="pick-form__label">Colour</span>
            <input class="pick-form__input" type="color" name="color" value={v('color', suggested)} />
            <span class="pick-form__hint">The dot beside their picks.</span>
          </label>

          <label class="pick-form__field">
            <span class="pick-form__label">Order</span>
            <input class="pick-form__input" type="number" name="sort_order" value={v('sort_order', contributors.length)} />
          </label>
        </div>

        <div class="pick-form__actions">
          <button class="pick-form__submit" type="submit">Add</button>
          <a class="pick-form__cancel" href={base}>Cancel</a>
        </div>
      </form>
    </div>
  </main>
</LpLayout>
