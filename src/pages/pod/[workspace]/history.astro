---
import PodLayout from '../../../layouts/PodLayout.astro';
import ListenItem from '../../../components/jp/ListenItem.astro';
import { resolveWorkspace } from '../../../lib/workspace';
import { loadLog, tagParam } from '../../../lib/pod/podcasts';

export const prerender = false;

const { supabase, user } = Astro.locals;
const workspace = await resolveWorkspace(supabase, 'podcasts', Astro.params.workspace!, user?.id ?? null);
if (!workspace) return new Response('Not found', { status: 404 });

const base = `/pod/${workspace.slug}`;
const tag = tagParam(Astro.url);
const page = Math.max(0, Number.parseInt(Astro.url.searchParams.get('page') ?? '0', 10) || 0);
const { rows, more } = await loadLog(supabase, workspace.id, { tag, page });

const link = (p: number) => {
  const q = new URLSearchParams();
  if (tag) q.set('tag', tag);
  if (p > 0) q.set('page', String(p));
  const s = q.toString();
  return `${base}/history${s ? `?${s}` : ''}`;
};
---

<PodLayout title={`History · ${workspace.name}`} workspace={workspace}>
  <header class="jp-head">
    <div>
      <p class="jp-kicker">History{tag ? ` · tagged ${tag}` : ''}</p>
      <h1>Every episode</h1>
      <p class="jp-lede">
        Most recent first. Episodes marked played in bulk when the library was set up have no date and come last.
        {tag && <a href={`${base}/history`}>Clear the tag.</a>}
      </p>
    </div>
  </header>

  {
    rows.length === 0 ? (
      <p class="jp-empty">Nothing here{tag ? ` tagged ${tag}` : ''}.</p>
    ) : (
      <ul class="jp-list">
        {rows.map(row => <ListenItem row={row} base={base} />)}
      </ul>
    )
  }

  <nav class="jp-pager" aria-label="Pages">
    {page > 0 ? <a href={link(page - 1)}>Newer</a> : <span />}
    {more && <a href={link(page + 1)}>Older</a>}
  </nav>
</PodLayout>
