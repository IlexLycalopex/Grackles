---
import Base from '../layouts/Base.astro';
import '../styles/launcher.css';
import { projectHref, type Linkable } from '../lib/apps';

export const prerender = false;

// The launcher used to be a fixed list of eight links. It is now whatever the
// visitor is a member of: signed out, it offers one thing — a way in.
//
// Membership, not readability. `workspaces_read` also returns every public and
// unlisted project on the site, so selecting from `workspaces` here would put
// other people's projects on your own front door. And `.eq('user_id', …)` is
// load-bearing despite RLS, for the reason dashboard.astro spells out:
// members_read exposes the whole roster to anyone in a project, so without it
// a project appears once per member.
const { user, supabase } = Astro.locals;

let projects: (Linkable & { name: string })[] = [];

if (user) {
  const { data } = await supabase
    .from('workspace_members')
    .select('workspaces(app, slug, name, external_url)')
    .eq('user_id', user.id);

  // `workspaces` is nullable in the join's type even though the FK is not.
  //
  // Sorted by name rather than by when you joined: this is a menu, and one
  // whose order shifts as projects are added is one you have to read every
  // time instead of reaching for the same place twice.
  projects = (data ?? [])
    .flatMap(m => (m.workspaces ? [m.workspaces] : []))
    .sort((a, b) => a.name.localeCompare(b.name, 'en'));
}

// A failed load leaves the nav with just the way through to /dashboard, which
// is where the error belongs — that page says what went wrong, and this one
// has nowhere to put it. Better than a front door reporting database trouble.
const wayThrough = user
  ? { href: '/dashboard', label: 'Your projects' }
  : { href: '/login', label: 'Sign in' };
---

<Base title="Grackles" bodyClass="launcher">
  <button class="hamburger" id="menuBtn" aria-label="Menu" aria-expanded="false">
    <svg width="20" height="14" viewBox="0 0 20 14" fill="none" aria-hidden="true" id="menuIcon">
      <path d="M0 1h20M0 7h20M0 13h20" stroke="currentColor" stroke-width="1.2"></path>
    </svg>
  </button>

  <nav class="nav-overlay" id="navOverlay">
    {
      projects.map((project, i) => {
        // A project still served from GitHub Pages opens in a new tab, as it
        // always has: it is a different site, and saying so is the honest
        // signal. One that has moved in does not.
        const external = Boolean(project.external_url);
        return (
          <a
            href={projectHref(project)}
            style={`--i: ${i}`}
            target={external ? '_blank' : undefined}
            rel={external ? 'noopener' : undefined}
          >
            {project.name}
          </a>
        );
      })
    }
    <a href={wayThrough.href} style={`--i: ${projects.length}`}>{wayThrough.label}</a>
  </nav>

  <div class="centre">
    <div class="logo-wrap">
      <img src="/grackles-logo.png" alt="Grackles logo" width="1152" height="1300" />
    </div>
    <div class="wordmark">
      <h1>Grackles</h1>
      <div class="rule"></div>
    </div>
  </div>

  <script>
    const btn = document.getElementById('menuBtn')!;
    const icon = document.getElementById('menuIcon')!;
    const nav = document.getElementById('navOverlay')!;

    const BARS = 'M0 1h20M0 7h20M0 13h20';
    const CROSS = 'M2 1l16 12M18 1L2 13';

    function setOpen(open: boolean) {
      nav.classList.toggle('open', open);
      btn.setAttribute('aria-expanded', String(open));
      icon.querySelector('path')!.setAttribute('d', open ? CROSS : BARS);
    }

    btn.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
    nav.querySelectorAll('a').forEach(a => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') setOpen(false);
    });
  </script>
</Base>
