---
import RlLayout from '../../../../layouts/RlLayout.astro';
import YearFields from '../../../../components/rl/YearFields.astro';
import { requireWrite } from '../../../../lib/workspace';
import { loadYears } from '../../../../lib/reading-list';
import { readYear } from '../../../../lib/records/year';
import { describeWriteError } from '../../../../lib/records/save';

export const prerender = false;

const { supabase, user } = Astro.locals;
const wsSlug = Astro.params.workspace!;

const gate = await requireWrite(
  supabase,
  'reading-list',
  wsSlug,
  user?.id ?? null,
  Astro.url.pathname + Astro.url.search
);
if (!gate.ok) return gate.response;
const workspace = gate.workspace;

const base = `/reading/${workspace.slug}`;
const years = await loadYears(supabase, workspace.id);

// The year after the newest one on the list, which is almost always the one
// being started. Falls back to the calendar year for an empty list.
const defaultYear = years.length > 0 ? Math.max(...years.map(y => y.year)) + 1 : new Date().getFullYear();

let error: string | null = null;
let submitted: FormData | null = null;

if (Astro.request.method === 'POST') {
  submitted = await Astro.request.formData();
  const parsed = readYear(submitted);

  if (!parsed.ok) {
    error = parsed.error;
  } else {
    const { error: writeError } = await supabase
      .from('rl_years')
      .insert({ workspace_id: workspace.id, ...parsed.values });

    if (writeError) {
      error = describeWriteError(writeError, 'rl_years insert');
    } else {
      return Astro.redirect(`${base}/${parsed.values.year}`);
    }
  }
}
---

<RlLayout title={`Add a year · ${workspace.name}`} workspace={workspace} years={years}>
  <div class="container">
    <div class="page-header">
      <h1>Add a year</h1>
      <p class="subtitle">A shelf for the books read in it.</p>
    </div>

    {error && <p class="form-error" role="alert">{error}</p>}

    <form method="POST" class="book-form">
      <YearFields year={null} defaultYear={defaultYear} submitted={submitted} />

      <div class="book-form__actions">
        <button class="book-form__submit" type="submit">Add year</button>
        <a class="book-form__cancel" href={base}>Cancel</a>
      </div>
    </form>
  </div>
</RlLayout>
