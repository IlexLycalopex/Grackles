---
import RlLayout from '../../../../layouts/RlLayout.astro';
import BookFields from '../../../../components/rl/BookFields.astro';
import { requireWrite } from '../../../../lib/workspace';
import LibraryPicker from '../../../../components/rl/LibraryPicker.astro';
import { currentYear, loadLibrary, loadYears } from '../../../../lib/reading-list';
import { keyOf } from '../../../../lib/library';
import { readBook } from '../../../../lib/records/book';
import { fillCover, fillFromLookup } from '../../../../lib/book-lookup';
import { describeWriteError } from '../../../../lib/records/save';

export const prerender = false;

const { supabase, user } = Astro.locals;
const wsSlug = Astro.params.workspace!;

const gate = await requireWrite(
  supabase,
  'reading-list',
  wsSlug,
  user?.id ?? null,
  Astro.url.pathname + Astro.url.search
);
if (!gate.ok) return gate.response;
const workspace = gate.workspace;

const base = `/reading/${workspace.slug}`;
const years = await loadYears(supabase, workspace.id);

// The year the button was pressed on, else the one under way — deliberately
// not the newest, which is next year's plan once one exists. No years at all
// means there is nothing to file a book under.
const requested = Number(Astro.url.searchParams.get('year'));
const year = years.find(y => y.year === requested) ?? currentYear(years);
if (!year) return Astro.redirect(`${base}/year/new`);

// A book put on a year that has not started is by definition not read yet, so
// the form opens with "coming up" ticked. It is a checkbox like any other and
// can be cleared.
const planning = year.status === 'planning';

/**
 * The next free position in a year.
 *
 * Read at render time and again on failure, because it is a guess: two people
 * adding a book at once both see the same number and the second one loses to
 * the unique index. That is the right outcome — the alternative is a sequence
 * that leaves gaps whenever a save is abandoned — and the error explains it.
 */
async function nextPosition(yearId: string): Promise<number> {
  const { data } = await supabase
    .from('rl_books')
    .select('order_read')
    .eq('year_id', yearId)
    .order('order_read', { ascending: false })
    .limit(1)
    .maybeSingle();
  return (data?.order_read ?? 0) + 1;
}

const entries = await loadLibrary(supabase, workspace.id);

let error: string | null = null;
let notice: string | null = null;
let submitted: FormData | null = null;

/**
 * Which book this is a reading of.
 *
 * Under the invariant there is no path that creates a reading without one, so
 * this page has two shapes: pick a book already in the library, or fill the
 * details in and have the book minted alongside the reading. Either way a
 * library entry exists before an rl_books row does.
 */
let chosenId: string | null = Astro.url.searchParams.get('library') || null;

if (Astro.request.method === 'POST') {
  submitted = await Astro.request.formData();
  const intent = String(submitted.get('intent') ?? '');
  const picked = String(submitted.get('library_id') ?? '');

  if (picked) chosenId = picked;
  if (intent === 'unchoose') chosenId = null;

  // Choosing from the picker is not a save. It re-renders the form with the
  // book's details filled in, so what gets written is still reviewed first.
  const choosing = Boolean(picked) || intent === 'unchoose';

  // A lookup fills the blanks of what was typed and stops. The form re-renders
  // from `submitted` either way, so the fetched values arrive by the same route
  // a rejected save does.
  if (intent === 'lookup') {
    notice = await fillFromLookup(submitted);
  } else if (!choosing) {
    const parsed = readBook(submitted);

    if (!parsed.ok) {
      error = parsed.error;
    } else {
      // Nobody has to press "Fetch details", so a blank cover is looked up on
      // the way past. It never fails the save.
      const values = await fillCover(parsed.values);

      // The book first, always. Where one was picked it already exists; where
      // one was not, the fold decides whether this is a book the library
      // already holds — so typing a title you own by hand joins that book
      // rather than minting a second copy of it.
      let libraryId = chosenId;

      if (!libraryId) {
        const key = keyOf({ title: values.title, author: values.author });
        const existing = entries.find(e => keyOf(e) === key);

        if (existing) {
          libraryId = existing.id;
          notice = `“${existing.title}” was already in your library, so this is a reading of that.`;
        } else {
          const { data: minted, error: mintError } = await supabase
            .from('rl_library')
            .insert({
              workspace_id: workspace.id,
              title: values.title,
              author: values.author,
              format: values.format,
              year_published: values.year_published,
              pages: values.pages,
              publisher: values.publisher,
              genre: values.genre,
              tags: values.tags,
              isbn: values.isbn,
              cover_url: values.cover_url,
              link_openlibrary: values.link_openlibrary,
              source: 'manual',
              // A book added because it is being read is a book in hand.
              ownership: 'owned',
            })
            .select('id')
            .single();

          if (mintError) error = describeWriteError(mintError, 'rl_library insert');
          else libraryId = minted?.id ?? null;
        }
      }

      if (!error && libraryId) {
        const { error: writeError } = await supabase
          .from('rl_books')
          .insert({ workspace_id: workspace.id, library_id: libraryId, ...values });

        if (writeError) {
          error = describeWriteError(writeError, 'rl_books insert');
        } else {
          return Astro.redirect(
            `${base}/${years.find(y => y.id === parsed.values.year_id)?.year ?? year.year}`
          );
        }
      }
    }
  }
}

const chosen = chosenId ? entries.find(e => e.id === chosenId) ?? null : null;

/**
 * The picked book's details, as the form's starting values.
 *
 * Copied into the reading rather than read through the join, deliberately: this
 * records the edition being read now, and replacing the copy on the shelf in
 * five years must not rewrite what this says about the one read today.
 */
const fromLibrary = chosen && !submitted?.get('title')
  ? {
      title: chosen.title,
      author: chosen.author,
      pages: chosen.pages,
      year_published: chosen.year_published,
      publisher: chosen.publisher ?? '',
      genre: chosen.genre ?? '',
      tags: chosen.tags,
      isbn: chosen.isbn ?? '',
      cover_url: chosen.cover_url ?? '',
      description: chosen.description ?? '',
      format: chosen.format,
      link_openlibrary: chosen.link_openlibrary,
    }
  : null;

const orderRead = await nextPosition(year.id);
---

<RlLayout title={`Add a book · ${workspace.name}`} workspace={workspace} years={years}>
  <div class="container">
    <div class="page-header">
      <h1>Add a book</h1>
      <p class="subtitle">
        {planning ? `Book ${orderRead} of the ${year.year} plan` : `Book ${orderRead} of ${year.year}`}
      </p>
    </div>

    {error && <p class="form-error" role="alert">{error}</p>}
    {notice && <p class="form-notice" role="status">{notice}</p>}

    <form method="POST" class="book-form">
      {entries.length > 0 && (
        <>
          <LibraryPicker entries={entries} chosenId={chosenId} />
          {!chosen && (
            <p class="book-form__hint">
              Every reading is a reading of a book in your library. Pick one
              above, or fill the details in below and the book will be added
              alongside it.
            </p>
          )}
        </>
      )}
      {chosenId && <input type="hidden" name="library_id" value={chosenId} />}

      <BookFields
        book={fromLibrary}
        years={years}
        defaults={{ yearId: year.id, orderRead, comingUp: planning }}
        submitted={submitted}
      />

      <div class="book-form__actions">
        <button class="book-form__submit" type="submit">Add book</button>
        <a class="book-form__cancel" href={`${base}/${year.year}`}>Cancel</a>
      </div>
    </form>
  </div>
</RlLayout>
