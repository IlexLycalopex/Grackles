---
import RlLayout from '../../../layouts/RlLayout.astro';
import BookCard from '../../../components/rl/BookCard.astro';
import FilterBar from '../../../components/rl/FilterBar.astro';
import YearProgress from '../../../components/rl/YearProgress.astro';
import { resolveWorkspace } from '../../../lib/workspace';
import { loadYear, loadYears, statsFor, yearProgress } from '../../../lib/reading-list';

export const prerender = false;

const { supabase, user } = Astro.locals;
const { workspace: wsSlug, year: yearParam } = Astro.params;

const workspace = await resolveWorkspace(supabase, 'reading-list', wsSlug!, user?.id ?? null);
if (!workspace) return new Response('Not found', { status: 404 });

const year = Number(yearParam);
if (!Number.isInteger(year)) return new Response('Not found', { status: 404 });

const [years, yearData] = await Promise.all([
  loadYears(supabase, workspace.id),
  loadYear(supabase, workspace.id, year),
]);

if (!yearData) return new Response('Not found', { status: 404 });

const base = `/reading/${workspace.slug}`;
const stats = statsFor(yearData.books);
const progress = yearProgress(yearData, yearData.books);
const planning = yearData.status === 'planning';
---

<RlLayout
  title={`${year} · ${workspace.name}`}
  description={`${stats.totalBooks} books read in ${year}`}
  workspace={workspace}
  years={years}
>
  <div class="container">
    <div class="page-header">
      <h1>{year}</h1>
      <p class="subtitle">
        {stats.totalBooks} book{stats.totalBooks !== 1 ? 's' : ''}
        {planning ? ' chosen' : ` · ${stats.totalPages.toLocaleString('en-GB')} pages`}
        {yearData.status === 'active' ? ' · in progress' : ''}
        {planning ? ' · in planning' : ''}
      </p>
      {
        planning && (
          <p class="year-planning-note">
            This year has not started. Its books are kept out of the totals on the overview until
            the year is marked in progress.
          </p>
        )
      }
    </div>

    {progress && <YearProgress progress={progress} status={yearData.status} />}

    {
      workspace.canWrite && (
        <div class="record-actions">
          <a class="record-actions__btn record-actions__btn--primary" href={`${base}/book/new?year=${year}`}>
            {planning ? '+ Add a book to the plan' : '+ Add a book'}
          </a>
          <a class="record-actions__btn" href={`${base}/year/${year}`}>
            Year settings
          </a>
        </div>
      )
    }

    <FilterBar />

    <div class="book-grid" id="book-grid">
      {
        yearData.books.map(book => (
          <div class="book-grid__item" data-book-id={book.id}>
            <BookCard book={book} showOrder />
            {workspace.canWrite && (
              <a class="book-edit" href={`${base}/book/${book.id}`} title={`Edit ${book.title}`}>
                Edit
              </a>
            )}
          </div>
        ))
      }
    </div>

    {
      yearData.books.length === 0 && (
        <p class="subtitle" style="padding:48px 0;">
          {planning ? `Nothing chosen for ${year} yet.` : `Nothing recorded for ${year} yet.`}
        </p>
      )
    }
  </div>
</RlLayout>
