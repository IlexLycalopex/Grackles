---
import AlbumLinks from './AlbumLinks.astro';
import type { Selection } from '../../lib/listening-party';

interface Props {
  pick: Selection;
  isNowPlaying?: boolean;
  /** Editors get a pencil on every card; everyone else gets none. */
  editHref?: string;
}

const { pick, isNowPlaying = false, editHref } = Astro.props;

const isUpcoming = pick.status === 'upcoming';
const hasNotes = !isUpcoming && Boolean(pick.notes.trim());
// Selection ids are unique per workspace, so this is safe even on the artists
// page where the same week can appear beside a pick from another season.
const modalId = `notes-${pick.id}`;
---

<article
  class={`album-card${isUpcoming ? ' album-card--upcoming' : ''}${isNowPlaying ? ' album-card--now-playing' : ''}`}
  id={isNowPlaying ? 'now-playing' : undefined}
  style={`--contrib-color: ${pick.contributor.color}`}
>
  {isNowPlaying && <div class="album-card__np-badge">▶ NOW PLAYING</div>}

  <div class="album-card__artwork">
    {
      !isUpcoming && pick.artworkUrl ? (
        <img src={pick.artworkUrl} alt={`${pick.album} by ${pick.artist}`} loading="lazy" />
      ) : (
        <div class="album-card__artwork-placeholder">
          {isUpcoming ? (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
              <circle cx="12" cy="12" r="9" />
              <circle cx="12" cy="12" r="3" />
              <path d="M12 3v3M12 18v3M3 12h3M18 12h3" stroke-linecap="round" />
            </svg>
          )}
        </div>
      )
    }
    <span class="album-card__week">Wk {pick.week}</span>
  </div>

  <div class="album-card__body">
    <div class="album-card__contributor">
      <span class="album-card__contributor-dot" style={`background:${pick.contributor.color}`}></span>
      {pick.contributor.name}
    </div>

    {
      isUpcoming ? (
        <div class="album-card__locked-label">{pick.album ? pick.album : 'Upcoming'}</div>
      ) : (
        <>
          <div class="album-card__title">{pick.album}</div>
          <div class="album-card__artist">{pick.artist}</div>
        </>
      )
    }

    <div class="album-card__links">
      {
        hasNotes && (
          <button
            class="album-card__link album-card__notes-trigger"
            data-modal={modalId}
            title="Read notes"
            aria-label="Read notes"
            type="button"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
              <polyline points="14 2 14 8 20 8" />
              <line x1="16" y1="13" x2="8" y2="13" />
              <line x1="16" y1="17" x2="8" y2="17" />
              <line x1="10" y1="9" x2="8" y2="9" />
            </svg>
          </button>
        )
      }
      {!isUpcoming && <AlbumLinks album={pick.album} artist={pick.artist} links={pick.links} />}
      {
        editHref && (
          <a class="album-card__link album-card__edit" href={editHref} title="Edit this pick" aria-label="Edit this pick">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9" />
              <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</article>

{
  hasNotes && (
    <div class="notes-modal" id={modalId} hidden aria-hidden="true">
      <div class="notes-modal__backdrop" data-close-modal />
      <div class="notes-modal__box" role="dialog" aria-modal="true" aria-label={`Notes for ${pick.album}`}>
        <div class="notes-modal__header">
          <div class="notes-modal__meta">
            <div class="notes-modal__album">{pick.album}</div>
            <div class="notes-modal__byline">
              <span class="notes-modal__dot" style={`background:${pick.contributor.color}`} />
              {pick.contributor.name} · {pick.artist}
            </div>
          </div>
          <button class="notes-modal__close" data-close-modal aria-label="Close notes" type="button">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <line x1="18" y1="6" x2="6" y2="18" />
              <line x1="6" y1="6" x2="18" y2="18" />
            </svg>
          </button>
        </div>
        <p class="notes-modal__body">{pick.notes}</p>
      </div>
    </div>
  )
}
