---
import { fieldValue } from '../../lib/forms';
import type { YearData } from '../../lib/reading-list';
import { YEAR_STATUSES, YEAR_STATUS_LABELS, defaultStatusFor } from '../../lib/records/year';

interface Props {
  year: YearData | null;
  defaultYear: number;
  submitted?: FormData | null;
}

const { year, defaultYear, submitted = null } = Astro.props;

const v = (key: string, stored?: string | number | null, fallback: string | number = '') =>
  fieldValue(submitted, key, stored, fallback);

// A year created ahead of the calendar opens as a plan; this year's opens as
// in progress. Editing an existing year shows what it already says.
const status = v('status', year?.status, defaultStatusFor(year?.year ?? defaultYear));

const recorded = year?.books.length ?? 0;
---

<label class="book-form__field">
  <span class="book-form__label">Year</span>
  <input
    class="book-form__input"
    type="number"
    name="year"
    value={v('year', year?.year, defaultYear)}
    readonly={year !== null}
    required
  />
  {
    year !== null && (
      <span class="book-form__hint">
        The year is the address of the page and every book in it points here, so it cannot be
        changed. Move the books instead.
      </span>
    )
  }
</label>

<div class="book-form__row">
  <label class="book-form__field">
    <span class="book-form__label">Status</span>
    <select class="book-form__input" name="status">
      {
        YEAR_STATUSES.map(s => (
          <option value={s} selected={status === s}>
            {YEAR_STATUS_LABELS[s]}
          </option>
        ))
      }
    </select>
    <span class="book-form__hint">
      A year in planning is next year's list, built before it starts. It is kept out of the totals
      and is never the year a book is filed under by default — move it to <em>in progress</em> when
      the year comes round.
    </span>
  </label>

  <label class="book-form__field">
    <span class="book-form__label">Target</span>
    <input
      class="book-form__input"
      type="number"
      name="total_books"
      min="1"
      value={v('total_books', year?.total_books)}
    />
    <span class="book-form__hint">
      How many books you are aiming for. Shown as a progress bar on the year and on the overview —
      against the calendar while the year runs, and against the list while it is being planned.
      {recorded > 0 && ` ${recorded} book${recorded === 1 ? '' : 's'} recorded so far.`}
      Leave blank if you are not counting.
    </span>
  </label>
</div>
