---
/**
 * A score, 0–5, set as a display-serif numeral in terracotta.
 *
 * Cedarhouse has no star or diamond row: a rating is a figure, and the figure
 * is one of the two things on the page allowed to be the accent colour. The
 * component keeps the name and props the diamond version had, so every caller
 * — the plates, the entry page, the stats distribution — is unchanged.
 */
interface Props {
  rating: number;
  /** Size of the numeral, as a CSS length. */
  size?: string;
  /** Print the "out of five" label beside it. */
  showValue?: boolean;
  /** Stack the label under the numeral, for the entry page masthead. */
  large?: boolean;
  class?: string;
}

const { rating, size, showValue = false, large = false, class: className } = Astro.props;

const clamped = Math.min(5, Math.max(0, rating));
// 3 → "3", 3.5 → "3.5"
const label = Number.isInteger(clamped) ? `${clamped}` : clamped.toFixed(1);
---
<span
  class:list={['score', large && 'score--lg', className]}
  role="img"
  aria-label={`${label} out of 5`}
>
  <span class="score__value" style={size ? `font-size: ${size}` : undefined} aria-hidden="true">
    {label}
  </span>
  {showValue && <span class="score__label" aria-hidden="true">out of five</span>}
</span>
