---
import StarRating from './StarRating.astro';
import StrengthChip from './StrengthChip.astro';
import {
  formatDate,
  formatDuration,
  photoUrl,
  restingDays,
  url,
  type Cigar,
} from '../../lib/cigar-helpers';

interface Props {
  cigar: Cigar;
  /** URL prefix for this workspace, e.g. /cigars/jamie */
  base: string;
  /** Rendered only for editors. */
  editHref?: string;
  /**
   * Rendered only for editors, and only in the humidor: the shortcut that
   * takes one out of the box and into the log. Editing the entry by hand does
   * the same thing, but that means remembering to decrement the quantity and
   * set the date — which is exactly the bookkeeping this app is meant to end.
   */
  smokeHref?: string;
}

const { cigar, base, editHref, smokeHref } = Astro.props;
const {
  status,
  quantity,
  name,
  brand,
  vitola,
  wrapper,
  strength,
  boughtAt,
  smokedAt,
  dateAcquired,
  dateSmoked,
  rating,
  photo,
} = cigar.data;

const spec = [vitola, wrapper].filter(Boolean).join(' · ');
const inHumidor = status === 'humidor';

// The date each view sorts and filters on: when it was smoked, or when it
// went into the humidor.
const sortDate = inHumidor ? dateAcquired : dateSmoked;
const resting = inHumidor ? restingDays(cigar) : null;
---
<article
  class="cigar-card"
  data-brand={brand}
  data-bought-at={boughtAt}
  data-smoked-at={smokedAt}
  data-date={sortDate?.toISOString().slice(0, 10) ?? ''}
  data-rating={rating ?? ''}
  data-name={name}
>
  {editHref && (
    <a class="cigar-card__edit" href={editHref} title={`Edit ${name}`} aria-label={`Edit ${name}`}>
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 20h9" />
        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z" />
      </svg>
    </a>
  )}

  {smokeHref && inHumidor && (
    <a class="cigar-card__smoke" href={smokeHref} title={`Smoke ${name}`}>
      Smoke
    </a>
  )}

  <a href={url(base, `cigar/${cigar.id}`)} class="cigar-card__link">
    {photo && (
      <div class="cigar-card__photo" data-photo>
        <img src={photoUrl(photo)} alt={`${name}`} loading="lazy" width="400" height="300" />
      </div>
    )}

    <div class="cigar-card__body">
      <p class="cigar-card__brand">{brand}</p>
      <h2 class="cigar-card__name">
        {name}
        {inHumidor && quantity > 1 && <span class="cigar-card__qty">×{quantity}</span>}
      </h2>
      <p class="cigar-card__spec">{spec}</p>

      <div class="cigar-card__rating">
        {inHumidor ? (
          <span class="cigar-card__resting">
            {resting !== null ? `Resting ${formatDuration(resting)}` : 'In the humidor'}
          </span>
        ) : rating !== undefined ? (
          <StarRating rating={rating} size="0.95rem" showValue />
        ) : (
          <span class="cigar-card__unrated">Unrated</span>
        )}
      </div>

      <div class="cigar-card__footer">
        {sortDate ? (
          <time datetime={sortDate.toISOString()}>
            {inHumidor ? 'Acquired ' : ''}{formatDate(sortDate)}
          </time>
        ) : <span />}
        {strength && <StrengthChip strength={strength} />}
      </div>
    </div>
  </a>
</article>

<style>
  .cigar-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: transparent;
    transition: border-color var(--transition), background var(--transition), transform var(--transition);
  }

  .cigar-card:hover {
    border-color: var(--border-gold);
    background: var(--bg-card);
    transform: translateY(-2px);
  }

  .cigar-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* Only rendered when a photo exists, so a missing one leaves no gap. */
  .cigar-card__photo {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
  }

  .cigar-card__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition);
  }

  .cigar-card:hover .cigar-card__photo img { transform: scale(1.03); }

  .cigar-card__body {
    padding: 1.15rem 1.25rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }

  /* The design runs the line/marque as a wide-tracked uppercase kicker. */
  .cigar-card__brand {
    font-size: 0.62rem;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #b98a54;
  }

  .cigar-card__name {
    font-family: var(--display);
    font-weight: 400;
    font-size: 1.3rem;
    line-height: 1.15;
    letter-spacing: 0.01em;
    color: var(--text);
  }

  .cigar-card__qty {
    display: inline-block;
    margin-left: 0.4rem;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--gold-muted);
    vertical-align: middle;
  }

  .cigar-card__spec {
    font-size: 0.8rem;
    font-weight: 300;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  .cigar-card__rating { margin-top: 0.55rem; }

  .cigar-card__unrated {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-dim);
  }

  .cigar-card__resting {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--foil);
  }

  .cigar-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-soft);
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--gold-muted);
  }
</style>
