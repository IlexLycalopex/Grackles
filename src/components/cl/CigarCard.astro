---
import StarRating from './StarRating.astro';
import StrengthChip from './StrengthChip.astro';
import {
  formatDate,
  formatDuration,
  photoUrl,
  restingDays,
  url,
  type Cigar,
} from '../../lib/cigar-helpers';

interface Props {
  cigar: Cigar;
  /** URL prefix for this workspace, e.g. /cigars/jamie */
  base: string;
  /** Rendered only for editors. */
  editHref?: string;
  /**
   * Rendered only for editors, and only in the humidor: the shortcut that
   * takes one out of the box and into the log. Editing the entry by hand does
   * the same thing, but that means remembering to decrement the quantity and
   * set the date — which is exactly the bookkeeping this app is meant to end.
   */
  smokeHref?: string;
}

const { cigar, base, editHref, smokeHref } = Astro.props;
const {
  status,
  quantity,
  name,
  brand,
  vitola,
  wrapper,
  strength,
  boughtAt,
  smokedAt,
  dateAcquired,
  dateSmoked,
  rating,
  photo,
} = cigar.data;

const spec = [vitola, wrapper].filter(Boolean).join(' · ');
const inHumidor = status === 'humidor';

// The corner controls are absolutely positioned at the card's top right, and
// the brand kicker is the line they land on. This used to depend on the photo,
// which was a full-bleed banner above the body for them to sit over; now that
// it is a thumbnail inside the body they always land on the kicker, so all
// that matters is whether there are any.
const showsSmoke = Boolean(smokeHref) && inHumidor;
const hasActions = Boolean(editHref) || showsSmoke;

// The date each view sorts and filters on: when it was smoked, or when it
// went into the humidor.
const sortDate = inHumidor ? dateAcquired : dateSmoked;
const resting = inHumidor ? restingDays(cigar) : null;
---
<article
  class:list={['cigar-card', hasActions && 'cigar-card--inset-actions']}
  data-brand={brand}
  data-bought-at={boughtAt}
  data-smoked-at={smokedAt}
  data-date={sortDate?.toISOString().slice(0, 10) ?? ''}
  data-rating={rating ?? ''}
  data-name={name}
>
  {editHref && (
    <a class="cigar-card__edit" href={editHref} title={`Edit ${name}`} aria-label={`Edit ${name}`}>
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 20h9" />
        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4z" />
      </svg>
    </a>
  )}

  {smokeHref && inHumidor && (
    <a class="cigar-card__smoke" href={smokeHref} title={`Smoke ${name}`}>
      Smoke
    </a>
  )}

  <a href={url(base, `cigar/${cigar.id}`)} class="cigar-card__link">
    <div class="cigar-card__body">
      {/* A cover, not a hero: enough to recognise the band across a grid of
          them, with the full picture one tap away on the entry itself. */}
      {/* The kicker stays on its own full-width line above the thumbnail. Put
          it beside one and it is squeezed between the picture and the corner
          controls, which wraps "Hoyo de Monterrey" onto two lines on exactly
          the cards that have a photo — so the same brand set differently
          depending on whether someone had added a picture. */}
      <p class="cigar-card__brand">{brand}</p>

      <div class="cigar-card__head">
        {photo && (
          <div class="cigar-card__thumb">
            <img src={photoUrl(photo)} alt="" loading="lazy" width="140" height="140" />
          </div>
        )}

        <div class="cigar-card__titles">
          <h2 class="cigar-card__name">
            {name}
            {inHumidor && quantity > 1 && <span class="cigar-card__qty">×{quantity}</span>}
          </h2>
          <p class="cigar-card__spec">{spec}</p>
        </div>
      </div>

      <div class="cigar-card__rating">
        {inHumidor ? (
          <span class="cigar-card__resting">
            {resting !== null ? `Resting ${formatDuration(resting)}` : 'In the humidor'}
          </span>
        ) : rating !== undefined ? (
          <StarRating rating={rating} size="0.95rem" showValue />
        ) : (
          <span class="cigar-card__unrated">Unrated</span>
        )}
      </div>

      <div class="cigar-card__footer">
        {sortDate ? (
          <time datetime={sortDate.toISOString()}>
            {inHumidor ? 'Acquired ' : ''}{formatDate(sortDate)}
          </time>
        ) : <span />}
        {strength && <StrengthChip strength={strength} />}
      </div>
    </div>
  </a>
</article>

<style>
  .cigar-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: transparent;
    transition: border-color var(--transition), background var(--transition), transform var(--transition);
  }

  .cigar-card:hover {
    border-color: var(--border-gold);
    background: var(--bg-card);
    transform: translateY(-2px);
  }

  .cigar-card__link {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  /* The thumbnail sits beside the title block rather than above the card, so
     a card without one is not a different shape — it simply starts at the
     kicker, and the grid row stays even either way. */
  .cigar-card__head {
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .cigar-card__titles {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  /* Only rendered when a photo exists, so a missing one leaves no gap. */
  .cigar-card__thumb {
    flex: 0 0 auto;
    width: 4.25rem;
    height: 4.25rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
  }

  .cigar-card__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition);
  }

  .cigar-card:hover .cigar-card__thumb img { transform: scale(1.04); }

  .cigar-card__body {
    padding: 1.15rem 1.25rem 1.1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
  }

  /* The design runs the line/marque as a wide-tracked uppercase kicker. */
  .cigar-card__brand {
    font-size: 0.62rem;
    font-weight: 300;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #b98a54;
  }

  /* Clears the smoke chip and the edit pencil, which on a photoless card are
     positioned over this line. Only the kicker is indented — the title below
     it starts at the card's edge like every other card. */
  .cigar-card--inset-actions .cigar-card__brand { padding-right: 6rem; }

  .cigar-card__name {
    font-family: var(--display);
    font-weight: 400;
    font-size: 1.3rem;
    line-height: 1.15;
    letter-spacing: 0.01em;
    color: var(--text);
  }

  .cigar-card__qty {
    display: inline-block;
    margin-left: 0.4rem;
    font-family: var(--mono);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    color: var(--gold-muted);
    vertical-align: middle;
  }

  .cigar-card__spec {
    font-size: 0.8rem;
    font-weight: 300;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  .cigar-card__rating { margin-top: 0.55rem; }

  .cigar-card__unrated {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold-dim);
  }

  .cigar-card__resting {
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--foil);
  }

  .cigar-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-soft);
    font-family: var(--mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: var(--gold-muted);
  }
</style>
