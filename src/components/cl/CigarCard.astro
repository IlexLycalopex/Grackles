---
import StarRating from './StarRating.astro';
import StrengthChip from './StrengthChip.astro';
import {
  daysSince,
  formatDuration,
  photoUrl,
  restingDays,
  url,
  type Cigar,
} from '../../lib/cigar-helpers';
import { haystackFor, sizeOf } from '../../lib/cigar-search';

interface Props {
  cigar: Cigar;
  /** URL prefix for this workspace, e.g. /cigars/jamie */
  base: string;
  /**
   * Position in the list as rendered, which becomes the plate number. Purely
   * presentational — it belongs to the row of the catalogue, not to the cigar,
   * and the script renumbers what is left after a filter runs.
   */
  index: number;
  /** Rendered only for editors. */
  editHref?: string;
  /**
   * Rendered only for editors, and only for something not yet smoked: the
   * shortcut that takes one out of the box and into the log. Editing the entry
   * by hand does the same thing, but that means remembering to decrement the
   * quantity and set the date — which is exactly the bookkeeping this app is
   * meant to end.
   */
  smokeHref?: string;
  /**
   * Where to POST "I have this now", for a wishlist card. A form rather than a
   * link because it is a write, and inline rather than a page because the whole
   * claim of the wishlist is that moving something off it is one press.
   */
  moveAction?: string;
}

const { cigar, base, index, editHref, smokeHref, moveAction } = Astro.props;
const {
  status,
  quantity,
  name,
  brand,
  vitola,
  country,
  strength,
  boughtAt,
  smokedAt,
  dateAcquired,
  dateSmoked,
  dateAdded,
  rating,
  photo,
} = cigar.data;

const spec = [vitola, country].filter(Boolean).join(' · ');
const inHumidor = status === 'humidor';
const wanted = status === 'wishlist';
const smoked = status === 'smoked';

// The date each view sorts and filters on: when it was smoked, when it went
// into the humidor, or — for something not yet owned — when it was wished for.
const sortDate = wanted ? dateAdded : inHumidor ? dateAcquired : dateSmoked;

// How long it has been waiting, for the two states where waiting is the fact
// the card is reporting. A smoked entry has finished waiting.
const resting = inHumidor ? restingDays(cigar) : null;
const wishedFor = wanted ? daysSince(dateAdded) : null;

// The index row's right-hand side: SEP '25. Short enough to sit opposite the
// plate number without either wrapping.
const stamp = sortDate
  ? `${sortDate.toLocaleString('en-GB', { month: 'short', timeZone: 'UTC' }).toUpperCase()} ’${String(
      sortDate.getUTCFullYear()
    ).slice(2)}`
  : '';

const plate = `PL. ${String(index + 1).padStart(2, '0')}`;

// What the filter box searches, built here so it is built once per card at
// render rather than once per card per keystroke. The size goes as two numbers
// beside it because `4 7/8"` cannot be compared with a `5x50` typed into the
// box until somebody has turned it into 4.875.
const haystack = haystackFor(cigar.data, cigar.body);
const size = sizeOf(cigar.data);
---
<article
  class="cigar-card"
  data-brand={brand}
  data-bought-at={boughtAt}
  data-smoked-at={smokedAt}
  data-country={country ?? ''}
  data-strength={strength ?? ''}
  data-date={sortDate?.toISOString().slice(0, 10) ?? ''}
  data-rating={rating ?? ''}
  data-name={name}
  data-search={haystack}
  data-length={size.lengthInches ?? ''}
  data-ring={size.ringGauge ?? ''}
>
  <a href={url(base, `cigar/${cigar.id}`)} class="cigar-card__link">
    <div class="cigar-card__index">
      <span class="cigar-card__plate-no" data-plate-index>{plate}</span>
      <span class="cigar-card__stamp">{stamp}</span>
    </div>

    {/* A specimen plate, not a hero: the framed picture is the same size and
        shape on every card, and an entry with no photo shows the hatched fill
        rather than collapsing to a different silhouette. */}
    <div class="cigar-card__frame">
      <div class="cigar-card__well">
        {photo
          ? <img src={photoUrl(photo)} alt="" loading="lazy" width="320" height="118" />
          : <span class="plate-fill" aria-hidden="true" />}
      </div>
    </div>

    <p class="cigar-card__brand">{brand}</p>

    <h2 class="cigar-card__name">
      {name}
      {!smoked && quantity > 1 && <span class="cigar-card__qty">×{quantity}</span>}
    </h2>

    {spec && <p class="cigar-card__spec">{spec}</p>}

    <div class="cigar-card__footer">
      {strength ? <StrengthChip strength={strength} pipsOnly /> : <span />}

      {wanted ? (
        <span class="cigar-card__resting cigar-card__resting--wanted">
          {wishedFor !== null ? `Wanted ${formatDuration(wishedFor)}` : 'Wanted'}
        </span>
      ) : inHumidor ? (
        <span class="cigar-card__resting">
          {resting !== null ? formatDuration(resting) : 'Resting'}
        </span>
      ) : rating !== undefined ? (
        <StarRating rating={rating} />
      ) : (
        <span class="score score--none" aria-label="Unrated"><span class="score__value">—</span></span>
      )}
    </div>
  </a>

  {/* Outside the card-wide link, because a link inside a link is not a link.
      Set as plain micro-text rather than chips floating over the plate: on
      paper a floating control reads as a smudge, and hover-only controls are
      unreachable on a phone. */}
  {(editHref || (smokeHref && !smoked) || (moveAction && wanted)) && (
    <div class="cigar-card__actions">
      {/* A one-press write, so a form — and a form inside the grid the filter
          script reorders, which is fine: it moves the whole card. */}
      {moveAction && wanted && (
        <form class="cigar-card__move" method="POST" action={moveAction}>
          <input type="hidden" name="intent" value="move" />
          <input type="hidden" name="cigar" value={cigar.rowId} />
          <button class="cigar-card__action" type="submit" aria-label={`Move ${name} to the humidor`}>
            To humidor
          </button>
        </form>
      )}
      {smokeHref && !smoked && (
        <a class="cigar-card__action" href={smokeHref}>Smoke</a>
      )}
      {editHref && (
        <a class="cigar-card__action" href={editHref} aria-label={`Edit ${name}`}>Edit</a>
      )}
    </div>
  )}
</article>

<style>
  .cigar-card {
    display: flex;
    flex-direction: column;
    padding: 17px 17px 15px;
    background: transparent;
    transition: background var(--transition);
  }

  .cigar-card:hover { background: var(--paper-raised); }

  .cigar-card__link { display: block; }

  .cigar-card__index {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .cigar-card__plate-no { color: var(--accent); }
  .cigar-card__stamp { color: var(--ink-muted); }

  .cigar-card__frame {
    margin: 12px 0 13px;
    padding: 5px;
    border: 1px solid var(--rule);
  }

  .cigar-card__well {
    height: 118px;
    overflow: hidden;
  }

  .cigar-card__well img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cigar-card__brand {
    font-size: 9.5px;
    font-weight: 400;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .cigar-card__name {
    margin-top: 7px;
    font-family: var(--display);
    font-weight: 400;
    font-size: 1.25rem;
    line-height: 1.08;
    color: var(--ink);
  }

  .cigar-card__qty {
    margin-left: 7px;
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    vertical-align: middle;
  }

  .cigar-card__spec {
    margin-top: 6px;
    font-size: 0.7rem;
    color: var(--ink-soft);
  }

  .cigar-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: 13px;
    padding-top: 11px;
    border-top: 1px solid var(--rule-soft);
  }

  .cigar-card__resting {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .cigar-card__actions {
    display: flex;
    gap: 14px;
    margin-top: 11px;
  }

  .cigar-card__resting--wanted { color: var(--accent); }

  /* The move is a form, so its button has to be talked back down into looking
     like the two links beside it. */
  .cigar-card__move { display: contents; }

  .cigar-card__action {
    padding: 0;
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
    background: none;
    border: none;
    cursor: pointer;
    transition: color var(--transition);
  }

  .cigar-card__action:hover { color: var(--accent); }
</style>
