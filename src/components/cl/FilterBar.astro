---
/**
 * The chips over a grid of plates: country, then strength, then the sort
 * control pushed to the right.
 *
 * A facet is only offered once something on the page carries it — a lounge
 * with nothing Dominican in it has no reason to show a Dominican chip — so the
 * caller passes the values it actually found rather than a fixed list.
 *
 * Like the search box beside it, this filters what is already rendered instead
 * of asking the server for a narrower set: both list pages load every entry in
 * the workspace to draw at all. The chosen chip and sort round-trip through the
 * query string, so a filtered log survives a reload and can be linked to.
 */
interface Sort {
  /** recent | oldest | rating | name — the orders the script knows. */
  key: string;
  label: string;
}

interface Props {
  /** id of the grid element whose children are filtered. */
  grid: string;
  countries: string[];
  strengths: string[];
  /** Offered in order; the control cycles through them. First is the default. */
  sorts?: Sort[];
}

const {
  grid,
  countries,
  strengths,
  sorts = [
    { key: 'recent', label: 'Recent' },
    { key: 'rating', label: 'Rated' },
    { key: 'name', label: 'A–Z' },
  ],
} = Astro.props;

// Nothing to filter by means nothing to render: a lone "All" chip is a control
// that cannot change anything.
const facets = [
  ...countries.map(value => ({ type: 'country', value })),
  ...strengths.map(value => ({ type: 'strength', value })),
];
---
{
  facets.length > 0 && (
    <div class="facet-bar" data-facet-bar data-grid={grid} data-sorts={JSON.stringify(sorts)} hidden>
      <button class="facet" type="button" data-facet-type="" data-facet-value="" aria-pressed="true">
        All
      </button>

      {facets.map(f => (
        <button
          class="facet"
          type="button"
          data-facet-type={f.type}
          data-facet-value={f.value}
          aria-pressed="false"
        >
          {f.value}
        </button>
      ))}

      <button class="facet-bar__sort" type="button" data-facet-sort>
        {sorts[0]!.label} ↓
      </button>
    </div>
  )
}

<script>
  import { refresh, setOut } from '../../lib/cigar-grid';

  interface Sort {
    key: string;
    label: string;
  }

  /** Unrated entries sort last, whichever way round the others go. */
  function ratingOf(card: HTMLElement): number | null {
    const raw = card.dataset.rating;
    return raw ? Number(raw) : null;
  }

  function compare(a: HTMLElement, b: HTMLElement, key: string): number {
    switch (key) {
      case 'oldest':
        return (a.dataset.date ?? '').localeCompare(b.dataset.date ?? '');
      case 'rating': {
        const ra = ratingOf(a);
        const rb = ratingOf(b);
        if (ra === null && rb === null) return 0;
        if (ra === null) return 1;
        if (rb === null) return -1;
        return rb - ra;
      }
      case 'name':
        return (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '');
      default: // recent
        return (b.dataset.date ?? '').localeCompare(a.dataset.date ?? '');
    }
  }

  for (const bar of document.querySelectorAll<HTMLElement>('[data-facet-bar]')) {
    const grid = document.getElementById(bar.dataset.grid ?? '');
    const sortBtn = bar.querySelector<HTMLButtonElement>('[data-facet-sort]');
    if (!grid || !sortBtn) continue;

    const chips = Array.from(bar.querySelectorAll<HTMLElement>('[data-facet-type]'));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-search]'));
    const sorts: Sort[] = JSON.parse(bar.dataset.sorts ?? '[]');
    if (cards.length < 2 || sorts.length === 0) continue;
    bar.hidden = false;

    // The rendered order is the first sort, so returning to it means putting
    // the cards back where they started rather than sorting by it again —
    // which for the humidor is a different comparison from the one the server
    // used to break ties.
    const rendered = cards.slice();

    let type = '';
    let value = '';
    let sort = 0;

    const apply = () => {
      for (const chip of chips) {
        const on = (chip.dataset.facetType ?? '') === type && (chip.dataset.facetValue ?? '') === value;
        chip.setAttribute('aria-pressed', String(on));
      }

      for (const card of cards) {
        const has = !type || (card.dataset[type as 'country' | 'strength'] ?? '') === value;
        setOut(card, 'facet', !has);
      }

      const order = sort === 0 ? rendered : cards.slice().sort((a, b) => compare(a, b, sorts[sort]!.key));
      for (const card of order) grid.append(card);

      sortBtn.textContent = `${sorts[sort]!.label} ↓`;
      refresh(grid);
    };

    const remember = () => {
      const url = new URL(window.location.href);
      // Both kinds go, then the chosen one comes back: only one chip can be
      // pressed, so leaving the other kind's parameter behind would hand out a
      // link describing a filter the page is not applying.
      url.searchParams.delete('country');
      url.searchParams.delete('strength');
      if (type) url.searchParams.set(type, value);
      if (sort > 0) url.searchParams.set('sort', sorts[sort]!.key);
      else url.searchParams.delete('sort');
      history.replaceState(null, '', url);
    };

    for (const chip of chips) {
      chip.addEventListener('click', () => {
        type = chip.dataset.facetType ?? '';
        value = chip.dataset.facetValue ?? '';
        apply();
        remember();
      });
    }

    sortBtn.addEventListener('click', () => {
      sort = (sort + 1) % sorts.length;
      apply();
      remember();
    });

    // What the query string asked for, if it asked for anything this page can
    // honour. A stale link naming a country nobody has smoked here any more
    // falls back to showing everything rather than an empty grid.
    const params = new URLSearchParams(window.location.search);
    for (const kind of ['country', 'strength'] as const) {
      const wanted = params.get(kind);
      const chip = wanted
        ? chips.find(c => c.dataset.facetType === kind && c.dataset.facetValue === wanted)
        : null;
      if (chip) {
        type = kind;
        value = wanted!;
      }
    }

    const wantedSort = sorts.findIndex(s => s.key === params.get('sort'));
    if (wantedSort > 0) sort = wantedSort;

    apply();
  }
</script>
